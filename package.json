{
  "name": "ryu",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "apps-store/*/ui",
      "crates/sdk/napi",
      "examples/*",
      "!apps/raycast"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/bun": "^1.3.4",
      "better-auth": "1.7.1",
      "@better-auth/api-key": "1.7.1",
      "@better-auth/mcp": "1.7.1",
      "@better-auth/oauth-provider": "1.7.1",
      "@better-auth/passkey": "1.7.1",
      "@better-auth/sso": "1.7.1",
      "@better-auth/scim": "1.7.1",
      "ai": "^7.0.0",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "sileo": "latest",
      "@tanstack/react-form": "^1.28.0",
      "@polar-sh/better-auth": "^1.6.4",
      "@ai-sdk/react": "^4.0.0",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18",
      "@better-auth/expo": "1.7.1"
    }
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/free-ports.mjs",
    "polar:provision": "bun run scripts/polar/provision-products.ts",
    "polar:audit": "bun run scripts/polar/audit-config.ts",
    "polar:provision-extras": "bun run scripts/polar/provision-extras.ts",
    "polar:provision-voucher": "bun run scripts/polar/provision-voucher.ts",
    "polar:provision-founding-trial": "bun run scripts/polar/provision-founding-trial.ts",
    "polar:provision-lifetime-launch": "bun run scripts/polar/provision-lifetime-launch.ts",
    "registry:generate": "bun tools/generate-registry.mjs",
    "registry:check": "bun tools/generate-registry.mjs --check",
    "rnp:check": "bun run tools/verify-rnp-contract.ts",
    "test:tools": "bun tools/check-api-target-propagation.mjs && node --test tools/ai-release-notes.test.mjs tools/public-release-notes.test.mjs tools/core-openapi-sync.test.mjs tools/pi-extension-syntax.test.mjs tools/generate-registry.test.mjs tools/generate-marketplace.test.mjs tools/generate-icons.test.mjs tools/mirror-plugins.test.mjs tools/mirror-satellites.test.mjs tools/public-hub-docs.test.mjs tools/sdk-hub.test.mjs tools/plugin-icon-coverage.test.mjs tools/plugin-runtime-pinning.test.mjs tools/route-permission-methods.test.mjs tools/profile-contract.test.mjs tools/standalone-apps.test.mjs tools/publish-release-notes.test.mjs tools/publish-workflows.test.mjs tools/toolsmith/harness.test.mjs tools/toolsmith/purity.test.mjs tools/toolsmith/manifest.test.mjs scripts/release/next-version.test.mjs scripts/release/channel-brand.test.mjs scripts/release/artifact-name.test.mjs scripts/wipe.test.mjs && bun test tools/generate-agent-plugins.test.mjs && bun tools/generate-agent-plugins.mjs --check",
    "test:plugins": "bun tools/run-plugin-tests.mjs",
    "skills:targets:sync": "node tools/sync-skill-agent-targets.mjs",
    "skills:targets:check": "node tools/sync-skill-agent-targets.mjs --check",
    "mirror:satellites": "bash tools/mirror-satellites.sh",
    "mirror:plugins": "bash tools/mirror-plugins.sh",
    "mirror:public": "bash tools/mirror-push.sh && bash tools/mirror-satellites.sh && bash tools/mirror-plugins.sh",
    "release:local": "bash scripts/release/release-local.sh",
    "publish:npm": "bash tools/publish-npm.sh",
    "publish:crates": "bash tools/publish-crates.sh",
    "dev": "node scripts/dev-stack.mjs",
    "kill-ports": "node scripts/free-ports.mjs",
    "wipe": "node scripts/wipe.mjs",
    "wipe:dry": "node scripts/wipe.mjs --dry-run",
    "build": "bun x --bun turbo build",
    "check-types": "bun x --bun turbo check-types",
    "test": "bun x --bun turbo test",
    "academy:generate": "bun tools/generate-academy-questions.ts",
    "academy:check": "bun tools/generate-academy-questions.ts --check && bun tools/check-academy-parity.ts",
    "coverage:rust": "cargo llvm-cov --workspace --summary-only --no-fail-fast",
    "test:rust": "cargo build -p ryu-core -p ryu-test-sidecar && cargo test --workspace --no-fail-fast -- --test-threads=1",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "migrate:list": "bun --filter server migrate:list",
    "migrate:up": "bun --filter server migrate:up",
    "migrate:down": "bun --filter server migrate:down",
    "migrate:create": "bun --filter server migrate:create",
    "dev:desktop": "turbo -F desktop dev",
    "dev:island": "turbo -F island dev",
    "dev:storyboard": "turbo -F storyboard dev",
    "dev:fumadocs": "turbo run dev --filter=fumadocs",
    "build:sdk": "turbo run build --filter=@ryuhq/sdk --filter=create-ryu-app --filter=@ryuhq/client",
    "dev:core": "turbo -F core dev",
    "dev:gateway": "turbo -F gateway dev",
    "dev:tts": "cd apps-store/voice/sidecar && python -m ryu_tts",
    "dev:unsloth": "cd apps-store/finetune/sidecar && python -m ryu_unsloth",
    "dev:cli": "bun run --filter cli dev",
    "clean": "turbo clean && bun run clean:rust",
    "clean:desktop": "turbo -F desktop clean",
    "clean:rust": "cargo clean --manifest-path apps/desktop/src-tauri/Cargo.toml; cargo clean --manifest-path apps/core/Cargo.toml; cargo clean --manifest-path apps/gateway/Cargo.toml; cargo clean --manifest-path apps-store/predict/Cargo.toml; cargo clean --manifest-path crates/ghost/core/Cargo.toml; cargo clean --manifest-path crates/ghost/eyes/Cargo.toml; cargo clean --manifest-path crates/ghost/hands/Cargo.toml; cargo clean --manifest-path crates/ghost/shadow/Cargo.toml; cargo clean --manifest-path crates/sdk/core/Cargo.toml; cargo clean --manifest-path crates/sdk/ffi/Cargo.toml; cargo clean --manifest-path crates/sdk/napi/Cargo.toml; cargo clean --manifest-path crates/sdk/uniffi/Cargo.toml",
    "check": "bun x --bun ultracite check",
    "check:app-ui": "bun tools/check-app-ui-contract.mjs",
    "check:anti-slop": "oxlint --config ./oxlint.config.ts .",
    "fix": "bun x --bun ultracite fix",
    "prepare": "husky",
    "env:export": "node scripts/env-sync.mjs export",
    "env:export:file": "node scripts/env-sync.mjs export --file --no-clipboard",
    "env:import": "node scripts/env-sync.mjs import",
    "env:import:file": "node scripts/env-sync.mjs import --file --force"
  },
  "dependencies": {
    "@ryu/env": "workspace:*",
    "dotenv": "catalog:",
    "mermaid": "^11.15.0",
    "next-themes": "^0.4.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@oxlint/plugins": "1.79.0",
    "@ryu/config": "workspace:*",
    "@takumi-rs/image-response": "^0.71.7",
    "@types/bun": "catalog:",
    "husky": "latest",
    "lint-staged": "latest",
    "oxlint": "1.79.0",
    "react": "^19.2.4",
    "turbo": "^2.8.12",
    "typescript": "^5",
    "ultracite": "7.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x --bun ultracite fix"
    ]
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "electron"
  ],
  "patchedDependencies": {
    "@expo/cli@55.0.16": "patches/@expo%2Fcli@55.0.16.patch"
  }
}

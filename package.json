{
  "name": "ryu",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/bun": "^1.3.4",
      "better-auth": "1.7.1",
      "@better-auth/api-key": "1.7.1",
      "@better-auth/mcp": "1.7.1",
      "@better-auth/oauth-provider": "1.7.1",
      "@better-auth/passkey": "1.7.1",
      "@better-auth/sso": "1.7.1",
      "@better-auth/scim": "1.7.1",
      "ai": "^7.0.0",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "sileo": "0.1.5",
      "@tanstack/react-form": "^1.28.0",
      "@polar-sh/better-auth": "^1.6.4",
      "@ai-sdk/react": "^4.0.0",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18",
      "@better-auth/expo": "1.7.1"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun x --bun turbo build",
    "check-types": "bun x --bun turbo check-types",
    "test": "bun x --bun turbo test",
    "clean:desktop": "turbo -F desktop clean",
    "check": "bun x --bun ultracite check",
    "fix": "bun x --bun ultracite fix",
    "test:toolsmith": "node --test tools/toolsmith/harness.test.mjs tools/toolsmith/manifest.test.mjs tools/toolsmith/purity.test.mjs"
  },
  "dependencies": {
    "@ryu/env": "workspace:*",
    "dotenv": "catalog:",
    "mermaid": "^11.15.0",
    "next-themes": "^0.4.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@oxlint/plugins": "1.79.0",
    "@ryu/config": "workspace:*",
    "@takumi-rs/image-response": "^0.71.7",
    "@types/bun": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "16.3.3",
    "oxlint": "1.79.0",
    "react": "^19.2.4",
    "turbo": "^2.8.12",
    "typescript": "^5",
    "ultracite": "7.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x --bun ultracite fix"
    ]
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "electron"
  ],
  "patchedDependencies": {
    "@expo/cli@55.0.16": "patches/@expo%2Fcli@55.0.16.patch"
  }
}

      "endpoint": "github.GITHUB_GET_THE_AUTHENTICATED_USER",
      "provider": "github",
      "source": "ryu",
      "tier": "curated",
      "toolkit": "github",
      "platform": "github",
      "capability": "account.whoami",
      "title": "Get the authenticated user",
      "docsUrl": "https://docs.github.com/en/rest/users/users#get-the-authenticated-user",
      "docsCheckedOn": "2026-10-21",
      "verification": {
        "checkedOn": "2026-10-21",
        "method": "docs_page",
        "state": "verified",
        "verifiedOn": "2026-10-21"
      },
      "operation": {
        "method": "GET",
        "path": "/user"
      },
      "probes": [
        {
          "kind": "docs_page",
          "url": "https://docs.github.com/en/rest/users/users",
          "expect": ["Get the authenticated user", "get /user"]
        },
        {
          "kind": "http",
          "method": "GET",
          "url": "https://api.github.com/user",
          "expectStatus": 200,
          "expectJson": "object",
          "expectKeys": ["login", "id"],
          "estimatedMicroUsd": 0,
          "credential": {
            "env": "RYU_VERIFY_GITHUB_TOKEN",
            "header": "Authorization",
            "scheme": "bearer"
          }
        }
      ],
      "note": "Live probe needs a user token (RYU_VERIFY_GITHUB_TOKEN); an Actions installation token cannot read /user."
    },

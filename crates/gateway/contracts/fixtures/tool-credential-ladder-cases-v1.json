{
  "version": 1,
  "description": "Shared cases for the tool credential ladder (Treg parity B5): crates/gateway/contracts/src/tool_credential_ladder.rs and packages/protocol/src/tool-credential-ladder.ts must both produce `expected` exactly.",
  "cases": [
    {
      "name": "team_key_wins_over_org_and_operator_and_is_unmetered",
      "input": {
        "slot": "tool:exa",
        "provider": "any",
        "ryuServes": true,
        "team": {
          "inScope": true,
          "candidate": {
            "credentialRef": {
              "id": "team_key",
              "version": 1,
              "fingerprint": "fp_team_key"
            },
            "status": "active"
          }
        },
        "org": {
          "inScope": true,
          "candidate": {
            "credentialRef": {
              "id": "org_key",
              "version": 1,
              "fingerprint": "fp_org_key"
            },
            "status": "active"
          }
        },
        "operator": {
          "hasKey": true,
          "price": "verified"
        },
        "allowDocumented": false,
        "treg": {
          "serves": true
        }
      },
      "expected": {
        "outcome": {
          "type": "selected",
          "rung": "team",
          "metered": false,
          "credentialRef": {
            "id": "team_key",
            "version": 1,
            "fingerprint": "fp_team_key"
          }
        },
        "trace": [
          {
            "rung": "team",
            "status": "selected"
          },
          {
            "rung": "org",
            "status": "shadowed"
          },
          {
            "rung": "operator",
            "status": "shadowed"
          },
          {
            "rung": "treg",
            "status": "ryu_serves"
          }
        ]
      }
    },

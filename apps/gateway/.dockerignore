# NOT used by the supported image build. apps/gateway/Dockerfile is built with
# the REPO ROOT as its context (`docker build -f apps/gateway/Dockerfile .`), so
# the repo-root .dockerignore applies. apps/gateway alone cannot build: it has
# path deps into crates/ and vendor/genai. This file only keeps local state and
# build output out of an ad-hoc context rooted here.
target/
**/*.rs.bk
*.pdb

# Local gateway state / audit store — never bake into the image.
*.sqlite
*.sqlite-*
*.db
gateway.toml
data/
/data/

# Docs, tests fixtures, and misc that don't affect the binary.
README.md
*.md
.git/
.gitignore
.env
.env.*

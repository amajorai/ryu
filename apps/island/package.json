{
  "name": "island",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build && node scripts/verify-built-bundles.mjs",
    "dist": "electron-vite build && node scripts/verify-built-bundles.mjs && electron-builder --config electron-builder.yml",
    "dist:win": "electron-vite build && node scripts/verify-built-bundles.mjs && electron-builder --win --config electron-builder.yml",
    "dist:mac": "electron-vite build && node scripts/verify-built-bundles.mjs && electron-builder --mac --config electron-builder.yml",
    "dist:linux": "electron-vite build && node scripts/verify-built-bundles.mjs && electron-builder --linux --config electron-builder.yml",
    "preview": "electron-vite preview",
    "check-types": "tsc --noEmit",
    "test": "bun test --isolate src",
    "clean": "node ../../scripts/clean-paths.mjs paths out artifacts && node ../../scripts/clean-paths.mjs pattern electron-vite"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@ryu/app-host": "workspace:*",
    "@ryu/blocks": "workspace:*",
    "@ryu/command": "workspace:*",
    "@ryu/i18n": "workspace:*",
    "@ryu/ui": "workspace:*",
    "@ryuhq/core-client": "workspace:*",
    "@ryuhq/protocol": "workspace:*",
    "@toolwind/corner-shape": "0.0.8-3",
    "ai": "catalog:",
    "electron-updater": "^6.8.11",
    "motion": "^11",
    "react": "^19",
    "react-dom": "^19",
    "uiohook-napi": "^1.5.5",
    "zustand": "^5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "catalog:",
    "typescript": "^5",
    "vite": "^6"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "1.1.1",
    "koffi": "^2.10.0",
    "mica-electron": "^1.5.17"
  },
  "author": {
    "name": "A Major Pte. Ltd.",

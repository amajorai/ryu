# Ryu Core (apps/core) — environment configuration
#
# Core is the orchestration engine (Axum, http://127.0.0.1:7980). Non-secret RYU_*
# overrides can live in the structured node config at the active OS config path:
# `ryu/node-config.json`. Environment values remain supported and take precedence;
# provider credentials, bootstrap values, and sidecar wiring stay environment-only.
# See config/node-config.example.json and the public Configuration guide.
# EVERYTHING here is OPTIONAL — Core ships sensible, fully-local defaults and runs
# on install with none of these set. Nothing is hardcoded: each model, engine,
# embedder, reranker, TTS/STT, sandbox, and RAG strategy is a swappable default.
#
# Convention below: `# NAME=` (commented) documents an override you can enable; a
# handful of canonical defaults are shown uncommented. Values shown after "default:"
# are the built-in fallback when the var is unset.
#
# OS-provided vars Core reads but you never set here: PATH, USERNAME, COMPUTERNAME,
# HOSTNAME (host/node-name auto-detection).

# ==============================================================================
# Bind / server / node identity
# ==============================================================================
# Address Core binds to. This is also the fail-closed gate: exposing beyond
# loopback is governed by this var (a `--bind=` flag cannot bypass it).
RYU_BIND=127.0.0.1:7980
# Bearer token required on protected API routes. Unset = no node auth (local only).
# RYU_TOKEN=
# Data directory root (db, models, plugins, spaces). Default: OS app-data dir.
# RYU_DIR=
# Extra CORS origins (comma-separated) added to the built-in desktop/web set.
# RYU_CORS_ORIGINS=
# Human-friendly node name (webhook relay, presence). Default: machine hostname.
# RYU_NODE_NAME=
# Publicly reachable URL of this node (control-plane registration).
# RYU_NODE_PUBLIC_URL=
# Ryu backend / identity+content plane base URL. Default: http://127.0.0.1:3000
# The managed webhook relay (RyuRelay) has no default: it starts only when this is
# set, and sends no account token otherwise.
# RYU_BACKEND_URL=
# Alias/override for the backend base URL used by cloud sync + gateway seeding.
# RYU_SERVER_URL=
# Managed-cloud control-plane base URL (credits, fleet). Falls back to RYU_SERVER_URL.
# RYU_CONTROL_PLANE_URL=
# Better Auth base URL used to verify node-user JWTs. Default: RYU_BACKEND_URL.
# RYU_AUTH_BASE_URL=
# BETTER_AUTH_URL=
# Master key (base64/hex) encrypting secrets at rest. Default: derived local key.
# RYU_MASTER_KEY=
# Multi-tenant scoping for a managed/cloud node.
# RYU_TEAM_ID=
# RYU_PROJECT_ID=
# Marks this as a managed cloud node (routes model traffic to the hosted fleet).
# RYU_MANAGED_NODE=
# Tool-exec approval mode for sandboxed/agent command execution (e.g. off/prompt).
# RYU_EXEC_APPROVAL_MODE=
# SSRF guard for agent HTTP egress (on by default) and its allowlist live in
# node-config.json: settings.agent.egressSsrfGuard / settings.agent.egressAllowHosts.

# ==============================================================================
# Default + fallback LLM (the chat/utility model when no agent overrides it)
# ==============================================================================
# Default agent (default: ryu) and default LLM model (default: gpt-4o-mini) live in
# node-config.json: settings.models.defaultAgent / settings.models.defaultLlm.model.
# OpenAI-compatible base URL for the default LLM. Default: https://api.openai.com
# RYU_DEFAULT_LLM_BASE_URL=
# Bearer key for the default LLM (falls back to OPENAI_API_KEY).
# RYU_DEFAULT_LLM_API_KEY=
# Fallback model (default gemma2) + URL (default http://127.0.0.1:8080):
# node-config.json settings.models.fallbackLlm.{model,baseUrl}.
# RYU_FALLBACK_LLM_API_KEY=
# Local llama.cpp chat server URL the managed gateway forwards to.
# LOCAL_LLM_URL=

# ==============================================================================
# Gateway link (Core runs the gateway as a managed sidecar and routes chat to it)
# ==============================================================================
# Gateway base URL (no trailing /v1). Default: http://127.0.0.1:7981
# RYU_GATEWAY_URL=
# Bearer token for the gateway when it runs with auth enabled.
# RYU_GATEWAY_TOKEN=
# Trusted Core relay for an externally managed Gateway. Keep out of agent envs.
# RYU_GATEWAY_CORE_TOKEN=
# Proof-only Core signer paired with GATEWAY_CORE_PROOF_KEY; never a bearer.
# RYU_GATEWAY_CORE_PROOF_KEY=
# Signing/data-plane key for a keyed/remote gateway.
# RYU_GATEWAY_KEY=
# Path/override for the gateway binary Core spawns.
# RYU_GATEWAY_BIN=
# Treat the gateway as externally managed (do not spawn a local one).
# RYU_GATEWAY_MANAGED=
# Remote data plane: keys live only in the hosted fleet; requires URL + TOKEN.
# RYU_GATEWAY_REMOTE=
# Path to a gateway config file passed through to the sidecar.
# GATEWAY_CONFIG=
# Seed the gateway firewall ON at first boot.
# GATEWAY_FIREWALL_ENABLED=
# Seed smart (classifier) model routing ON at first boot.
# GATEWAY_SMART_ROUTING_ENABLED=
# Gateway injection into ACP agents (default on): node-config.json
# settings.acp.gatewayInject.
# Run npx-launched ACP agents straight from their installed bin with node
# (default on): settings.features.acpDirectSpawn (0 turns it off; false is not read).

# ==============================================================================
# Managed-cloud credits / billing (Core reads these to seed the gateway)
# ==============================================================================
# Enable credit metering + wallet enforcement on the gateway.
# GATEWAY_CREDITS_ENABLED=
# Credits/debit endpoint the gateway posts to.
# GATEWAY_CREDITS_URL=
# Shared secret for internal credit debit calls.
# RYU_CREDITS_INTERNAL_SECRET=
# Action when a wallet hits zero (e.g. stop/allow).
# GATEWAY_CREDITS_WALLET_EMPTY_ACTION=
# Per-tool-call cost in micro-USD.
# GATEWAY_CREDITS_COST_PER_TOOL_CALL_MICRO_USD=
# Free sandbox storage allowance (GiB) before metering.
# GATEWAY_CREDITS_SANDBOX_FREE_STORAGE_GIB=
# Sandbox billing markup in basis points.
# GATEWAY_CREDITS_SANDBOX_MARKUP_BPS=

# ==============================================================================
# Chat / local model registry (bundled defaults — all swappable)
# ==============================================================================
# Bundled weights: node-config.json settings.local.<kind>Model{Id,Url,Sha256}
# (chat|classifier|guard|reranker|speech), settings.models.localEmbedding.*,
# settings.mmproj.quant (default f16).

# ==============================================================================
# Embeddings / reranker / RAG (local by default: nomic-embed + bge-reranker)
# ==============================================================================
# Embedding model (default: nomic-embed-text-v1.5), dims and provider live in
# node-config.json: settings.models.embedding.{model,dims,provider}.
# Remote embeddings base URL (unset = local llamacpp-embed on :8081).
# RYU_EMBED_BASE_URL=
# Bearer key for remote embeddings (falls back to OPENAI_API_KEY).
# RYU_EMBED_API_KEY=
# Reranker model + provider: node-config.json settings.reranker.{model,provider}.
# Remote reranker base URL + key (unset = local).
# RYU_RERANKER_BASE_URL=
# RYU_RERANKER_API_KEY=
# RAG: node-config.json settings.rag.{strategy,provider,vectorStore.*},
# settings.graph.extractionModel, settings.fts.recallEnabled (default off).
# Auto-recall (default on, top-K 5) lives in node-config.json:
# settings.rag.autoRecall.{enabled,topK}. The per-turn context cap,
# settings.rag.contextMaxTokens, is unset by default, so no history is trimmed;
# set it to a positive token count, or "auto" to size it to the loaded model.

# ==============================================================================
# Local inference engines (weight/model overrides — pick per format)
# ==============================================================================
# RYU_OMLX_MODEL_DIR=       # OpenMLX model directory
# MLX + Parakeet: node-config.json settings.mlx.{model,vlmModel},
# settings.parakeet.modelUrl. vLLM/SGLang/stable-diffusion.cpp models and the
# Silero VAD mirror: settings.{vllm,sglang,sd}.model,
# settings.silero.{vadModelUrl,vadModelSha256}. whisper.cpp model path and
# audio.cpp model root: settings.whisper.model, settings.audiocpp.modelDir.

# ==============================================================================
# Voice: TTS / STT
# ==============================================================================
# TTS/STT engines: node-config.json settings.voice.{ttsEngine,sttEngine}
# (defaults kokoro; parakeet, or whisper on lean builds). Gateway STT:
# settings.stt.{gatewayProvider,gatewayModel} (unset = local).
# Kokoro model + voices weight paths.
# RYU_KOKORO_MODEL=
# RYU_KOKORO_VOICES=
# Kokoro mirrors + OuteTTS: node-config.json settings.kokoro.{modelUrl,voicesUrl},
# settings.outetts.{model,vocoder}.

# ==============================================================================
# MCP / tools / execution
# ==============================================================================
# MCP registry + tool allowlist: node-config.json settings.mcp.{registryUrl,allowlist}.
# Per-agent: RYU_MCP_ALLOWLIST_<AGENT_ID> (env or node-config "overrides").
# Exa search MCP.
# RYU_EXA_API_KEY=
# JS sandbox per-run memory cap (default 256 MB): settings.tool.execMemoryMb.

# ==============================================================================
# Sandbox backends (default: wasmtime in-process; others opt-in / auto-detect)
# ==============================================================================
# Backend (wasmtime|docker|daytona|microsandbox|opensandbox) + Box size/timeout:
# node-config.json settings.sandbox.{backend,boxSize,boxTimeoutSecs},
# settings.persistent.sandboxBackend.
# Disable the sandbox entirely.
# RYU_SANDBOX_DISABLED=
# Per-backend CLI, image and probe timeout: node-config.json
# settings.sandbox.<backend>{Binary,Image,DetectSecs} for docker, microsandbox,
# opensandbox (+ opensandboxTimeout), singularity; mxc{Binary,DetectSecs,
# AllowDaclMutation}, sshBinary, localEnable (default off).
# Daytona cloud sandbox (billed compute).
# RYU_SANDBOX_DAYTONA_URL=
# RYU_SANDBOX_DAYTONA_TOKEN=      # or DAYTONA_API_KEY
# DAYTONA_API_KEY=
# RYU_SANDBOX_DAYTONA_TARGET=
# RYU_SANDBOX_DAYTONA_SNAPSHOT=
# Sizing (2 vCPU, 4 GiB, 10 GiB, linux, no GPU, 30s timeout): node-config.json
# settings.sandbox.daytona{Vcpu,MemGib,StorageGib,Os,Gpu,GpuCount,TimeoutSecs}.

# ==============================================================================
# Ghost / Shadow / Restate / yt-dlp tool sidecars
# ==============================================================================
# Ghost, Island and Shadow release mirrors: node-config.json
# settings.{ghost,island,shadow}.releaseUrl. Managed app sidecars:
# settings.sidecar.{releaseBase,idleSecs,sandbox,sandboxPlugins}.
# Shadow (screen/audio capture) service URL.
# RYU_SHADOW_URL=
# Shadow's LLM defaults to the local Gateway's /v1 and model "default":
# node-config.json settings.shadow.{llmBaseUrl,llmModel}. Key for a non-Gateway LLM:
# SHADOW_LLM_API_KEY=
# Speaker-diarization service URL (meetings).
# RYU_DIARIZE_URL=
# Restate admin URL (legacy engine): node-config.json settings.restate.adminUrl.
# yt-dlp release (pinned in code) and download URL: node-config.json
# settings.ytdlp.{version,url}.

# ==============================================================================
# Skills
# ==============================================================================
# node-config.json settings.skills.disclosure (boot seed, the saved preference
# wins; default progressive) and settings.skills.author (agent skill authoring
# opt-in, default off).

# ==============================================================================
# Plugins / apps / marketplace + catalog federation
# ==============================================================================
# App/plugin registry URL.
# RYU_APP_REGISTRY_URL=
# Custom catalog sources file (default state/catalog-sources.json):
# node-config.json settings.catalog.sourcesFile.
# Marketplace hosted API + publish token + verify key (repo: node-config.json
# settings.marketplace.repo).
# Marketplace API base URL. Defaults to the hosted control plane
# (https://api.ryuhq.com); set to http://localhost:3000 for local dev / self-host.
# RYU_MARKETPLACE_API_URL=
# RYU_MARKETPLACE_TOKEN=
# RYU_MARKETPLACE_PUBLIC_KEY=
# Catalog sources: node-config.json settings.hosted.mcpIndexUrl,
# settings.features.integrationsSh*, settings.github.topic*.
# Treg catalog (default https://treg.to, cached 86400s) and merge order:
# settings.treg.{catalogUrl,catalogCacheTtlSecs}, settings.tool.catalogPrecedence.
# Agent treg.describe/treg.call tools (default off): settings.features.tregAgentTools.
# Smithery MCP registry key.
# SMITHERY_API_KEY=

# ==============================================================================
# Chat power-feature models & judges (each falls back to the default LLM)
# ==============================================================================
# RYU_ADVISOR_MODEL=            # /advisor stronger-reviewer model
# /btw side-question model + effort: node-config.json settings.btw.{model,effort}.
# Predictive-typing model: node-config.json settings.predict.model.

# ==============================================================================
# Continual learning
# ==============================================================================
# RYU_LEARNING_ENABLED=         # master switch (default off)
# RYU_LEARNING_SKILLS_ENABLED=  # skill synthesis from experience
# RYU_LEARNING_PRM_MODEL=       # process-reward model (falls back to default LLM)
# Loop interval and synthesis model: node-config.json
# settings.learning.{interval,synthModel}.

# ==============================================================================
# Provider API keys (BYOK — all optional; absent keys degrade cleanly)
# ==============================================================================
# OpenAI (also the fallback key for default LLM + embeddings).
# OPENAI_API_KEY=
# Anthropic (Pi provider catalog + gateway upstream).
# ANTHROPIC_API_KEY=
# Pi provider catalog keys (apps/core/src/pi_config/mod.rs — all optional BYOK).
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# CEREBRAS_API_KEY=
# FIREWORKS_API_KEY=
# TOGETHER_API_KEY=
# NVIDIA_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=
# MINIMAX_API_KEY=
# The OpenRouter, fal.ai, Replicate and Composio env keys below are the user's own
# (self-hosted BYOK). A managed node (RYU_MANAGED_NODE=1) ignores them: it holds
# no Ryu provider keys and reaches the hosted fleet with its rgw_ credential.
# OpenRouter (RYU_ prefixed takes precedence over the bare name).
# RYU_OPENROUTER_API_KEY=
# OPENROUTER_API_KEY=
# Hugging Face token (gated model downloads).
# HF_TOKEN=
# fal.ai image/media.
# FAL_API_KEY=
# Replicate image/media.
# REPLICATE_API_KEY=
# Composio integrations (RYU_ prefixed wins).
# RYU_COMPOSIO_API_KEY=
# COMPOSIO_API_KEY=
# COMPOSIO_ENTITY_ID=
# COMPOSIO_WEBHOOK_SECRET=
# GIF provider (default klipy): gif-provider pref or node-config.json
# settings.gif.provider. Keys:
# TENOR_API_KEY=
# GIPHY_API_KEY=
# KLIPY_API_KEY=
# Artificial Analysis model-benchmark data.
# ARTIFICIAL_ANALYSIS_API_KEY=

# ==============================================================================
# Identity vault
# ==============================================================================
# node-config.json settings.identity.{defaultSource,healthInterval} (default 1h).

# ==============================================================================
# Email / SMTP (agent + notification egress)
# ==============================================================================
# RYU_SMTP_HOST=
# RYU_SMTP_PORT=
# RYU_SMTP_USERNAME=
# RYU_SMTP_PASSWORD=
# RYU_SMTP_FROM=
# RYU_SMTP_STARTTLS=

# ==============================================================================
# Mesh networking (Tailscale, fail-closed) + webhook ingress
# ==============================================================================
# Enable the mesh (fail-closed when tokenless) and pin its backend:
# node-config.json settings.mesh.{enabled,backend}. Either wins over Settings.
# RYU_MESH_AUTHKEY=
# RYU_MESH_LOGIN_SERVER=
# RYU_MESH_SOCKS5_ADDR=
# RYU_MESH_HTTP_PROXY_ADDR=
# Public URL for inbound webhook ingress.
# RYU_WEBHOOK_INGRESS_URL=

# ==============================================================================
# Hardware companion nodes
# ==============================================================================
# RYU_HARDWARE_NODE_URL=
# RYU_HARDWARE_ALLOWED_HOSTS=

# ==============================================================================
# Spaces / media / downloads
# ==============================================================================
# Wiki link expansion in Spaces (default on): settings.spaces.linkExpansion.
# Vector cache (256 MiB), trace retention (90 days, 1000000 spans), Box idle
# (600s) and vault tunables: settings.vector.cacheMb,
# settings.trace.{retentionDays,maxRows}, settings.session.boxIdleSecs, settings.vault.*.
# Media output directory for generated images/audio (default files/media):
# node-config.json settings.media.dir.
# Download manager: auto-resume of interrupted downloads is node-config.json
# settings.downloads.autoresume (set to 1; default off). The state files default
# to state/downloads{,-history}.json: settings.downloads.{file,historyFile}.
# Operator pin that locks the Settings parallel-download count.
# RYU_MAX_CONCURRENT_DOWNLOADS=

# ==============================================================================
# Cloud sync / headroom / Pi + external agent homes
# ==============================================================================
# Enable cross-device SyncClient.
# RYU_SYNC_ENABLED=
# Headroom (community savings telemetry) service.
# RYU_HEADROOM_ENABLED=
# node-config.json settings.headroom.{url,managed} and
# settings.pi.{autoUpdate,transcriptMaxAgeDays} (defaults on, 30 days).
# Pi agent config directory.
# RYU_PI_AGENT_DIR=
# Codex home (upstream default).
# CODEX_HOME=
# Claude Code config dir (usage/history integration).
# CLAUDE_CONFIG_DIR=

# ==============================================================================
# Telemetry / privacy / crash reporting (all opt-in, no telemetry by default)
# ==============================================================================
# Crash reporting DSN (forwarded to the managed Gateway as RYU_SENTRY_DSN).
# SENTRY_DSN=
# RYU_CRASH_REPORTS_ENABLED=
# Privacy pref defaults (on): node-config.json settings.product.analyticsEnabled,
# settings.profile.activityEnabled.
# Diagnostics export defaults: node-config.json settings.diagnostics.{exportEnabled,
# contentMode,maxContentBytes}. The Settings privacy preference wins over them.
# RYU_COMMUNITY_STATS_ENABLED=
# RYU_SUPPORT_ACCESS_LOCAL_ENABLED=
# PostHog key for product analytics.
# RYU_POSTHOG_KEY=
# OpenTelemetry OTLP export.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

  {
    "name": "control group gates read on matching path",
    "baseline": ["list"],
    "subjects": ["user:alice"],
    "policies": [
      {
        "name": "gated",
        "rules": [
          {
            "path": "prod/**",
            "capabilities": ["read"],
            "controlGroup": {
              "ttlSecs": 3600,
              "factors": [
                {
                  "name": "sec",
                  "approvers": ["team:sec"],
                  "approvals": 1
                }
              ]
            }
          }
        ]
      }
    ],
    "path": "prod/KEY",
    "expected": ["list", "read"],
    "expectedControlGroup": true,
    "expectedControlGroupFactors": ["gated/0/sec"]
  },
  {
    "name": "control group keeps same-named factors from every matching rule of one policy",
    "baseline": ["list"],
    "subjects": ["user:alice"],
    "policies": [
      {
        "name": "prod-access",
        "rules": [
          {
            "path": "prod/**",
            "capabilities": ["read"],
            "controlGroup": {
              "factors": [
                {
                  "name": "approval",
                  "approvers": ["team:leads"],
                  "approvals": 1
                }
              ]
            }
          },
          {
            "path": "prod/payments/*",
            "capabilities": ["read"],
            "controlGroup": {
              "factors": [
                {
                  "name": "approval",
                  "approvers": ["user:cfo", "user:ceo"],
                  "approvals": 2
                }
              ]
            }
          }
        ]
      }
    ],
    "path": "prod/payments/STRIPE_KEY",
    "expected": ["list", "read"],
    "expectedControlGroup": true,
    "expectedControlGroupFactors": [
      "prod-access/0/approval",
      "prod-access/1/approval"
    ]
  },
  {

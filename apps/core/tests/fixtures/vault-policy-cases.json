                }
              ]
            }
          }
        ]
      },
      {
        "name": "prod-access",
        "rules": [
          {
            "path": "prod/**",
            "capabilities": ["read"],
            "controlGroup": {
              "factors": [
                {
                  "name": "approval",
                  "approvers": ["team:leads"],
                  "approvals": 1
                }
              ]
            }
          },
          {
            "path": "prod/payments/*",
            "capabilities": ["read"],
            "controlGroup": {
              "factors": [
                {
                  "name": "approval",

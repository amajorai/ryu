  "name": "desktop",
  "private": true,
  "scripts": {
    "brand:dev": "node ../../scripts/release/channel-brand.mjs --channel dev --config apps/desktop/src-tauri/tauri.dev.conf.json",
    "build": "node scripts/build.mjs",
    "build:bot": "node scripts/product.mjs build bot",
    "build:dev": "bun run brand:dev && tauri build --config src-tauri/tauri.dev.conf.json --features dev-variant",
    "build:harness": "vite build --config e2e/harness/vite.harness.config.ts",
    "build:harness:onboarding-final": "vite build --config e2e/harness/vite.onboarding-final-step.config.ts",
    "build:harness:welcome": "vite build --config e2e/harness/vite.welcome.config.ts",
    "build:standalone": "node scripts/standalone.mjs",
    "build:vite": "NODE_OPTIONS=--max-old-space-size=16384 vite build && bun ../../tools/watch/bundle-artifact-gate.ts dist",
    "build:vite:standalone": "NODE_OPTIONS=--max-old-space-size=16384 vite build && bun ../../tools/watch/bundle-artifact-gate.ts dist",
    "check-types": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "clean": "rm -rf src-tauri/target dist build",
    "dev": "node scripts/dev.mjs",
    "dev:bot": "node scripts/product.mjs dev bot",
    "dev:vite": "vite",
    "licenses": "node ../../tools/generate-desktop-licenses.mjs",
    "licenses:check": "node ../../tools/generate-desktop-licenses.mjs --check",
    "tauri": "tauri",
    "test": "bun run scripts/test-isolated.ts",
    "test:e2e": "playwright test",
    "test:e2e:agent-run-history": "playwright test --config e2e/agent-run-history-interactions.playwright.config.ts",
    "test:e2e:chat-page-control-paths": "playwright test --config e2e/chat-page-control-paths.playwright.config.ts",
    "test:e2e:customize-sidebar": "playwright test --config e2e/customize-sidebar-proof.playwright.config.ts",
    "test:e2e:declarative-views": "playwright test --config e2e/playwright.declarative-view-proof.config.ts",
    "test:e2e:diff-review": "playwright test --config e2e/diff-review-proof.playwright.config.ts",
    "test:e2e:drafts-page": "playwright test --config e2e/drafts-page-proof.playwright.config.ts",
    "test:e2e:graphrag-live": "playwright test --config e2e/graphrag-spaces-live.playwright.config.ts",
    "test:e2e:import-setup-dialog": "playwright test --config e2e/import-setup-dialog-interactions.playwright.config.ts",
    "test:e2e:inbox-center": "playwright test --config e2e/inbox-center-interactions-proof.playwright.config.ts",
    "test:e2e:library-collections": "playwright test --config e2e/library-collections-proof.playwright.config.ts",
    "test:e2e:library-item-menu": "playwright test --config e2e/library-item-menu-interactions.playwright.config.ts",
    "test:e2e:list": "playwright test --list",
    "test:e2e:live": "RYU_E2E_LIVE=1 playwright test available-updates-story.live",
    "test:e2e:marketplace-store": "playwright test --config e2e/marketplace-store-home.playwright.config.ts && playwright test --config e2e/library-engine-settings.playwright.config.ts && playwright test --config e2e/marketplace-store-catalogs.playwright.config.ts",
    "test:e2e:marketplace-store-catalogs": "playwright test --config e2e/marketplace-store-catalogs.playwright.config.ts",
    "test:e2e:marketplace-store-full": "bun run test:e2e:marketplace-store && bun run test:e2e:marketplace-store-interactions && bun run test:e2e:marketplace-store-models",
    "test:e2e:marketplace-store-interactions": "playwright test --config e2e/marketplace-store-interactions.playwright.config.ts",
    "test:e2e:marketplace-store-models": "playwright test --config e2e/marketplace-store-models.playwright.config.ts",
    "test:e2e:memory-reflect": "playwright test --config e2e/memory-reflect-interactions.playwright.config.ts",
    "test:e2e:onboarding-final": "playwright test --config e2e/onboarding-final-step.playwright.config.ts",
    "test:e2e:onboarding-first-project": "playwright test --config e2e/onboarding-first-project-integration-proof.playwright.config.ts",
    "test:e2e:onboarding-privacy": "playwright test --config e2e/onboarding-privacy-step-proof.playwright.config.ts",
    "test:e2e:first-project": "playwright test --config e2e/first-project-proof.playwright.config.ts",
    "test:e2e:settings": "node scripts/test-settings-e2e.mjs",
    "test:e2e:share-conversation-toolbar": "playwright test --config e2e/share-conversation-toolbar-entry.playwright.config.ts",
    "test:e2e:spaces-database-query-proof": "bunx vite build --emptyOutDir --config e2e/harness/vite.spaces-database-query-proof.config.ts --outDir ../../../../target/spaces-database-query-proof-build && playwright test --config e2e/spaces-database-query-proof.playwright.config.ts --workers=1",
    "test:e2e:spaces-database-excel-proof": "bunx vite build --emptyOutDir --config e2e/harness/vite.spaces-database-query-proof.config.ts --outDir ../../../../target/spaces-database-query-proof-build && playwright test --config e2e/spaces-database-excel-proof.playwright.config.ts --workers=1",
    "test:e2e:vault-secrets": "playwright test --config e2e/vault-secrets-interactions-proof.playwright.config.ts",
    "test:e2e:welcome": "playwright test --config e2e/welcome-step-story.playwright.config.ts",
    "test:performance:gateway": "bun test src/hooks/useGatewayStatus.test.tsx && playwright test --config playwright.gateway-polling-proof.config.ts",
    "test:wiring": "bun test e2e/wiring/"
  },
  "type": "module",
  "version": "0.5.0"
}

{
  "name": "desktop",
  "private": true,
  "version": "0.2.7",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:dev": "bun run brand:dev && tauri build --config src-tauri/tauri.dev.conf.json --features dev-variant",
    "build:bot": "node scripts/product.mjs build bot",
    "build:standalone": "node scripts/standalone.mjs",
    "tauri": "tauri",
    "dev:vite": "vite",
    "build:vite:standalone": "NODE_OPTIONS=--max-old-space-size=16384 vite build",
    "dev:bot": "node scripts/product.mjs dev bot",
    "build:vite": "NODE_OPTIONS=--max-old-space-size=16384 vite build",
    "check-types": "tsc --noEmit",
    "test": "bun run scripts/test-isolated.ts",
    "test:e2e": "playwright test",
    "test:e2e:graphrag-live": "playwright test --config e2e/graphrag-spaces-live.playwright.config.ts",
    "test:e2e:list": "playwright test --list",
    "test:e2e:live": "RYU_E2E_LIVE=1 playwright test available-updates-story.live",
    "test:wiring": "bun test e2e/wiring/",
    "build:harness": "vite build --config e2e/harness/vite.harness.config.ts",
    "build:harness:welcome": "vite build --config e2e/harness/vite.welcome.config.ts",
    "test:e2e:welcome": "playwright test --config e2e/welcome-step-story.playwright.config.ts",
    "clean": "rm -rf src-tauri/target dist build",
    "brand:dev": "node ../../scripts/release/channel-brand.mjs --channel dev --config apps/desktop/src-tauri/tauri.dev.conf.json"
  },

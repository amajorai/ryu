{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ryu",
  "mainBinaryName": "Ryu",
  "identifier": "ai.amajor.ryu.desktop",
  "version": "0.5.1",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev:vite",
    "beforeBuildCommand": "bun run build:vite"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Ryu",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; script-src-elem 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http://localhost:* http://127.0.0.1:*; font-src 'self' data:; media-src 'self' blob: data: https:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* http://*:7980 http://*:8980 http://*:9980 http://*:10980 http://*:11980 ws://*:7980 ws://*:8980 ws://*:9980 ws://*:10980 ws://*:11980 ws://localhost:* ws://127.0.0.1:* wss: https:; frame-src 'self' about: blob: http: https:; object-src 'none'; base-uri 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "locales/en.lproj/InfoPlist.strings",
        "Resources/ar.lproj/InfoPlist.strings": "locales/ar.lproj/InfoPlist.strings",
        "Resources/de.lproj/InfoPlist.strings": "locales/de.lproj/InfoPlist.strings",
        "Resources/es.lproj/InfoPlist.strings": "locales/es.lproj/InfoPlist.strings",
        "Resources/fr.lproj/InfoPlist.strings": "locales/fr.lproj/InfoPlist.strings",
        "Resources/hi.lproj/InfoPlist.strings": "locales/hi.lproj/InfoPlist.strings",
        "Resources/it.lproj/InfoPlist.strings": "locales/it.lproj/InfoPlist.strings",
        "Resources/ja.lproj/InfoPlist.strings": "locales/ja.lproj/InfoPlist.strings",
        "Resources/ko.lproj/InfoPlist.strings": "locales/ko.lproj/InfoPlist.strings",
        "Resources/pt-BR.lproj/InfoPlist.strings": "locales/pt-BR.lproj/InfoPlist.strings",
        "Resources/ru.lproj/InfoPlist.strings": "locales/ru.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "locales/zh-Hans.lproj/InfoPlist.strings"
      }
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Arabic",
          "German",
          "Spanish",
          "French",
          "Hindi",
          "Italian",
          "Japanese",
          "Korean",
          "PortugueseBR",
          "Russian",
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "Hindi": "nsis/Hindi.nsh"
        }
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ryu"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/amajorai/ryu/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3NTBCRjA0NDQ1QjEyMDEKUldRQkVsdEVCTDlRZDNNQmNTQWU4VmlCMlFjRk5rdXQ0Q0V4WkxhSUFBcmxOTE5oUm81ZTRRTG4K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

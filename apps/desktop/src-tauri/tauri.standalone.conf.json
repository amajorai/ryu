{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ryu App",
  "mainBinaryName": "Ryu App",
  "identifier": "ai.amajor.ryu.apphost",
  "version": "0.2.0",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev:vite",
    "beforeBuildCommand": "bun run build:vite:standalone"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Ryu App",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; script-src-elem 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http://localhost:* http://127.0.0.1:*; font-src 'self' data:; media-src 'self' blob: data: https:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; frame-src 'self' about: blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../standalone-resources/sidecars/*": "standalone/sidecars"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "locales/en.lproj/InfoPlist.strings",
        "Resources/ar.lproj/InfoPlist.strings": "locales/ar.lproj/InfoPlist.strings",
        "Resources/de.lproj/InfoPlist.strings": "locales/de.lproj/InfoPlist.strings",
        "Resources/es.lproj/InfoPlist.strings": "locales/es.lproj/InfoPlist.strings",
        "Resources/fr.lproj/InfoPlist.strings": "locales/fr.lproj/InfoPlist.strings",
        "Resources/hi.lproj/InfoPlist.strings": "locales/hi.lproj/InfoPlist.strings",
        "Resources/it.lproj/InfoPlist.strings": "locales/it.lproj/InfoPlist.strings",
        "Resources/ja.lproj/InfoPlist.strings": "locales/ja.lproj/InfoPlist.strings",
        "Resources/ko.lproj/InfoPlist.strings": "locales/ko.lproj/InfoPlist.strings",
        "Resources/pt-BR.lproj/InfoPlist.strings": "locales/pt-BR.lproj/InfoPlist.strings",
        "Resources/ru.lproj/InfoPlist.strings": "locales/ru.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "locales/zh-Hans.lproj/InfoPlist.strings"
      }
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Arabic",
          "German",
          "Spanish",
          "French",
          "Italian",
          "Japanese",
          "Korean",
          "PortugueseBR",
          "Russian",
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ryu-app"]
      }
    }
  }
}

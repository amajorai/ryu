{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ryu Bot",
  "mainBinaryName": "Ryu Bot",
  "identifier": "ai.amajor.ryu.bot",
  "app": {
    "windows": [
      {
        "title": "Ryu Bot",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ryubot"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/amajorai/ryu/releases/latest/download/latest-bot.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3NTBCRjA0NDQ1QjEyMDEKUldRQkVsdEVCTDlRZDNNQmNTQWU4VmlCMlFjRk5rdXQ0Q0V4WkxhSUFBcmxOTE5oUm81ZTRRTG4K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "locales/en.lproj/InfoPlist.strings",
        "Resources/ar.lproj/InfoPlist.strings": "locales/ar.lproj/InfoPlist.strings",
        "Resources/de.lproj/InfoPlist.strings": "locales/de.lproj/InfoPlist.strings",
        "Resources/es.lproj/InfoPlist.strings": "locales/es.lproj/InfoPlist.strings",
        "Resources/fr.lproj/InfoPlist.strings": "locales/fr.lproj/InfoPlist.strings",
        "Resources/hi.lproj/InfoPlist.strings": "locales/hi.lproj/InfoPlist.strings",
        "Resources/it.lproj/InfoPlist.strings": "locales/it.lproj/InfoPlist.strings",
        "Resources/ja.lproj/InfoPlist.strings": "locales/ja.lproj/InfoPlist.strings",
        "Resources/ko.lproj/InfoPlist.strings": "locales/ko.lproj/InfoPlist.strings",
        "Resources/pt-BR.lproj/InfoPlist.strings": "locales/pt-BR.lproj/InfoPlist.strings",
        "Resources/ru.lproj/InfoPlist.strings": "locales/ru.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "locales/zh-Hans.lproj/InfoPlist.strings"
      }
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Arabic",
          "German",
          "Spanish",
          "French",
          "Italian",
          "Japanese",
          "Korean",
          "PortugueseBR",
          "Russian",
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}

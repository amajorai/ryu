{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ryu (Dev)",
  "mainBinaryName": "Ryu Dev",
  "identifier": "ai.amajor.ryu.desktop.dev",
  "app": {
    "windows": [
      {
        "title": "Ryu (Dev)",
        "zoomHotkeysEnabled": true
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ryu-dev"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/amajorai/ryu/releases/download/nightly/latest-nightly.json"
      ]
    }
  },
  "bundle": {
    "icon": [
      "icons/dev/32x32.png",
      "icons/dev/128x128.png",
      "icons/dev/128x128@2x.png",
      "icons/dev/icon.icns",
      "icons/dev/icon.ico"
    ]
  }
}

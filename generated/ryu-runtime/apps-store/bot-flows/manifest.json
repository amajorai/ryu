{
  "tags": [
    "chatbots",
    "support",
    "lead-capture",
    "conversational-forms",
    "productivity"
  ],
  "author": {
    "name": "Ryu",
    "url": "https://ryuhq.com"
  },
  "repository": "https://github.com/amajorai/ryu-bot-flows",
  "homepage": "https://github.com/amajorai/ryu-bot-flows",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/bot-flows",
  "name": "Bot Flows",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Productivity",
  "description": "Build conversational bots from preconfigured flows for support, lead capture, surveys, and intake, then share or embed them.",
  "tagline": "Build chat bots from preconfigured flows",
  "keywords": [
    "chatbot",
    "bot builder",
    "support bot",
    "lead capture",
    "conversational form",
    "nps",
    "quiz",
    "intake"
  ],
  "icon": "chat-bot",
  "iconDither": { "from": 24, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "none" },
    "mobile": { "support": "none" },
    "extension": { "support": "none" },
    "web": { "support": "none" },
    "cli": { "support": "none" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "bot-flows-companion",
      "name": "Bot Flows",
      "kind": "companion",
      "config": {
        "label": "Bot Flows",
        "ui_entry": "./ui/dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": ["app:http", "hook:side-model", "assistant:context"],
  "permission_levels": [
    {
      "id": "bot-flows.view",
      "label": "Can view",
      "description": "View bots, their analytics, and the conversations they collect."
    },
    {
      "id": "bot-flows.manage",
      "label": "Can manage",
      "description": "Create and edit bots, publish or unpublish them, and manage their knowledge.",
      "implies": ["bot-flows.view"]
    }
  ],
  "companion": {
    "label": "Bot Flows",
    "icon": "chat-bot"
  },
  "contributes": {
    "sidebar_buttons": [
      {
        "id": "bot-flows-workspace",
        "title": "Bot Flows",
        "icon": "chat-bot",
        "target": "/plugin/app__bot-flows-companion",
        "context": { "view": "bots" },
        "order": 73
      }
    ],
    "hook_events": [
      {
        "id": "@ryu/bot-flows#conversation.completed",
        "title": "Bot conversation completed",
        "description": "A visitor reached the end of a published bot. Fires once per conversation; preview runs from the builder never fire it.",
        "payload_example": {
          "bot_id": "bot_01J9Z8Q4",
          "bot_slug": "support",
          "bot_name": "Support assistant",
          "result_id": "res_01J9Z8R2",
          "variables": { "email": "ada@example.com", "topic": "Billing" },
          "answers": [
            {
              "block_id": "b_email",
              "variable": "email",
              "value": "ada@example.com"
            }
          ],
          "completed_at": "2026-10-19T14:02:11Z"
        }
      },
      {
        "id": "@ryu/bot-flows#handoff.requested",
        "title": "Bot handoff requested",
        "description": "A published bot ran a Handoff block, for example to open a support ticket or pass a lead to sales. Fires each time a Handoff block runs; preview runs never fire it. Use the topic to route it.",
        "payload_example": {
          "bot_id": "bot_01J9Z8Q4",
          "bot_slug": "support",
          "bot_name": "Support assistant",
          "result_id": "res_01J9Z8R2",
          "topic": "support",
          "summary": "Billing question from ada@example.com",
          "variables": { "email": "ada@example.com", "issue": "Charged twice" },
          "transcript": [
            { "from": "bot", "text": "What can I help with?" },
            { "from": "visitor", "text": "Billing" }
          ],
          "requested_at": "2026-10-19T14:01:40Z"
        }
      }
    ]
  },
  "sidecars": [
    {
      "name": "bot-flows",
      "process": {
        "kind": "local",
        "command": "ryu-bot-flows",
        "command_env": "RYU_BOT_FLOWS_BIN",
        "port_env": "RYU_BOT_FLOWS_PORT"
      },
      "port": 8028,
      "health_path": "/health",
      "lazy": true,
      "idle_stop_secs": 900,
      "host_api": { "grants": ["hook:side-model"] },
      "http": {
        "mount": "/api/bot-flows",
        "public_mount": "/bots",
        "max_body_bytes": 1048576,
        "routes": [
          {
            "path": "/status",
            "method": "GET",
            "permission": "bot-flows.view"
          },
          {
            "path": "/admin/templates",
            "method": "GET",
            "permission": "bot-flows.view"
          },
          {
            "path": "/admin/bots",
            "method": "GET",
            "permission": "bot-flows.view"
          },
          {
            "path": "/admin/bots",
            "method": "POST",
            "permission": "bot-flows.manage"
          },
          {
            "path": "/admin/bots/:id",
            "method": "GET",
            "permission": "bot-flows.view"
          },
          {
            "path": "/admin/bots/:id",
            "method": "PUT",
            "permission": "bot-flows.manage"
          },
          {
            "path": "/admin/bots/:id",
            "method": "DELETE",
            "permission": "bot-flows.manage"
          },
          {
            "path": "/admin/bots/:id/publish",
            "method": "POST",
            "permission": "bot-flows.manage"
          },
          {
            "path": "/admin/bots/:id/unpublish",
            "method": "POST",
            "permission": "bot-flows.manage"
          },
          {
            "path": "/admin/bots/:id/duplicate",
            "method": "POST",
            "permission": "bot-flows.manage"
          },
          {
            "path": "/admin/bots/:id/preview",
            "method": "POST",
            "permission": "bot-flows.manage"
          },
          {
            "path": "/admin/preview/:sessionId/reply",
            "method": "POST",
            "permission": "bot-flows.manage"
          },
          {
            "path": "/admin/bots/:id/results",
            "method": "GET",
            "permission": "bot-flows.view"
          },
          {
            "path": "/admin/bots/:id/results",
            "method": "DELETE",
            "permission": "bot-flows.manage"
          },
          {
            "path": "/admin/bots/:id/results/:resultId",
            "method": "GET",
            "permission": "bot-flows.view"
          },
          {
            "path": "/admin/bots/:id/results/:resultId",
            "method": "DELETE",
            "permission": "bot-flows.manage"
          },
          {
            "path": "/admin/bots/:id/analytics",
            "method": "GET",
            "permission": "bot-flows.view"
          },
          {
            "path": "/admin/bots/:id/export",
            "method": "GET",
            "permission": "bot-flows.view"
          },
          {
            "path": "/admin/bots/:id/knowledge",
            "method": "GET",
            "permission": "bot-flows.view"
          },
          {
            "path": "/admin/bots/:id/knowledge",
            "method": "PUT",
            "permission": "bot-flows.manage"
          },
          { "path": "/:slug", "method": "GET", "auth": "public" },
          { "path": "/:slug/embed.js", "method": "GET", "auth": "public" },
          { "path": "/:slug/sessions", "method": "POST", "auth": "public" },
          {
            "path": "/:slug/sessions/:sessionId/reply",
            "method": "POST",
            "auth": "public"
          }
        ]
      }
    }
  ]
}

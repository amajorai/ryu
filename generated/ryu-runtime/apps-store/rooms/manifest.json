{
  "tags": ["rooms", "chat", "mesh-llm", "multi-device"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-rooms",
  "homepage": "https://github.com/amajorai/ryu-rooms",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/rooms",
  "name": "Rooms",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Communication",
  "description": "Shared model rooms hosted by your active Ryu node. Start a Mesh LLM session on the node, invite phones or browsers by QR, and keep the transcript synchronized without exposing node credentials.",
  "tagline": "Share one model session across your devices",
  "keywords": ["rooms", "chat", "mesh-llm", "multi-device", "qr"],
  "icon": "message-multiple-01",
  "iconDither": { "from": 198, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "rooms-companion",
      "name": "Rooms",
      "kind": "companion",
      "config": {
        "label": "Rooms",
        "ui_entry": "./ui/dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "sidecars": [
    {
      "name": "ryu-rooms",
      "process": {
        "kind": "local",
        "command": "ryu-rooms",
        "command_env": "RYU_ROOMS_BIN",
        "port_env": "RYU_ROOMS_PORT"
      },
      "port": 8024,
      "health_path": "/health",
      "http": {
        "mount": "/api/rooms",
        "public_mount": "/api/rooms",
        "routes": [
          { "path": "/", "method": "GET", "permission": "rooms.view" },
          { "path": "/", "method": "POST", "permission": "rooms.create" },
          { "path": "/guest", "method": "GET", "auth": "public" },
          { "path": "/guest/exchange", "method": "POST", "auth": "public" },
          { "path": "/guest/snapshot", "method": "GET", "auth": "public" },
          { "path": "/guest/events", "method": "GET", "auth": "public" },
          { "path": "/guest/turns", "method": "POST", "auth": "public" },
          {
            "path": "/:room_id",
            "method": "GET",
            "permission": "rooms.view",
            "resource_param": "room_id"
          },
          {
            "path": "/:room_id/turns",
            "method": "POST",
            "permission": "rooms.run",
            "resource_param": "room_id"
          },
          {
            "path": "/:room_id/stop",
            "method": "POST",
            "permission": "rooms.run",
            "resource_param": "room_id"
          },
          {
            "path": "/:room_id/close",
            "method": "POST",
            "permission": "rooms.manage",
            "resource_param": "room_id"
          },
          {
            "path": "/:room_id/invite",
            "method": "POST",
            "permission": "rooms.manage",
            "resource_param": "room_id"
          },
          {
            "path": "/:room_id/invite/revoke",
            "method": "POST",
            "permission": "rooms.manage",
            "resource_param": "room_id"
          }
        ]
      },
      "host_api": {
        "grants": ["hook:side-model", "app:realtime"]
      }
    }
  ],
  "permission_grants": [
    "app:http",
    "app:realtime",
    "hook:side-model",
    "core:list_agents",
    "shell:integrate"
  ],
  "permission_levels": [
    {
      "id": "rooms.view",
      "label": "Can view rooms",
      "description": "See rooms hosted by the active Ryu node and their synchronized transcripts."
    },
    {
      "id": "rooms.create",
      "label": "Can create rooms",
      "description": "Start a room on the active node and issue an invite to selected devices."
    },
    {
      "id": "rooms.run",
      "label": "Can run rooms",
      "description": "Submit prompts to a room's selected local model and stop its active generation.",
      "implies": ["rooms.view"]
    },
    {
      "id": "rooms.manage",
      "label": "Can manage rooms",
      "description": "Close a room or revoke its device invite.",
      "implies": ["rooms.view"]
    }
  ],
  "companion": {
    "label": "Rooms",
    "icon": "message-multiple-01"
  },
  "contributes": {
    "sidebar_buttons": [
      {
        "id": "rooms",
        "title": "Rooms",
        "icon": "hugeicons:message-multiple-01",
        "target": "/plugin/app__rooms-companion",
        "order": 64
      }
    ]
  }
}

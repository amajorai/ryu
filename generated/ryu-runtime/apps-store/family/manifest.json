{
  "tags": ["family", "birthdays", "lists", "gifts", "household"],
  "author": {
    "name": "Ryu",
    "url": "https://ryuhq.com"
  },
  "repository": "https://github.com/amajorai/ryu-family",
  "homepage": "https://github.com/amajorai/ryu-family",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/family",
  "name": "Family",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Productivity",
  "description": "A shared family hub for Ryu: important dates with reminders, shared lists and chores, wishlists, and gift ideas that stay hidden from the person they are for. The node your family uses keeps the records; nothing is bought on your behalf.",
  "tagline": "Birthdays, lists, and gift ideas in one place",
  "keywords": [
    "family",
    "birthdays",
    "reminders",
    "grocery list",
    "chores",
    "wishlist",
    "gift ideas"
  ],
  "icon": "user-love-01",
  "iconDither": {
    "from": 186,
    "to": "transparent",
    "direction": "down"
  },
  "surfaces": {
    "gateway": {
      "support": "none"
    },
    "core": {
      "support": "full"
    },
    "desktop": {
      "support": "full"
    },
    "island": {
      "support": "limited"
    },
    "mobile": {
      "support": "limited"
    },
    "extension": {
      "support": "none"
    },
    "web": {
      "support": "full"
    },
    "cli": {
      "support": "list"
    }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "family-agent",
      "name": "Family Planner",
      "kind": "agent",
      "config": {
        "description": "Plans birthdays and occasions, suggests gifts within a budget, and keeps shared family lists.",
        "system_prompt": "You are Family Planner, a helper for one family's shared hub. Use the family tools for every lookup or change: upcoming dates, people, important dates, shared lists and chores, family-visible preferences, wishlists, and gift context. Ask for a missing name, date, or list instead of guessing, and report what the tool returned. To suggest gifts, call family.gift_context first, then use web.search to find options within the stated budget; reply with a short list of links and price ranges, and say that prices and availability may have changed. Never buy, reserve, or check out anything, never fill in payment details, and never claim a purchase happened. Treat every conversation as one the whole family may see: share only lists, dates, and family-visible details, and never reveal or guess gift ideas or which wishlist items someone has claimed. Gift ideas and wishlist claims are kept in the Family app; when someone wants to save a gift idea or claim a wishlist item, ask them to do it there. Chore points are a simple tally, not money.",
        "tools": ["family", "web.search"]
      }
    },
    {
      "id": "family-companion",
      "name": "Family",
      "kind": "companion",
      "config": {
        "label": "Family",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "sidecars": [
    {
      "name": "family",
      "process": {
        "kind": "local",
        "command": "ryu-family",
        "command_env": "RYU_FAMILY_BIN",
        "port_env": "RYU_FAMILY_PORT"
      },
      "port": 8025,
      "health_path": "/health",
      "host_api": { "grants": ["crypto:seal"] },
      "lazy": false,
      "http": {
        "mount": "/api/family",
        "public_mount": "/api/family",
        "routes": [
          {
            "path": "/upcoming",
            "method": "GET",
            "permission": "family.view"
          },
          {
            "path": "/people",
            "method": "GET",
            "permission": "family.view"
          },
          {
            "path": "/people",
            "method": "POST",
            "permission": "family.edit"
          },
          {
            "path": "/people/:id",
            "method": "PATCH",
            "permission": "family.edit"
          },
          {
            "path": "/people/:id",
            "method": "DELETE",
            "permission": "family.edit"
          },
          {
            "path": "/people/:id/claim",
            "method": "POST",
            "permission": "family.edit"
          },
          {
            "path": "/dates",
            "method": "GET",
            "permission": "family.view"
          },
          {
            "path": "/dates",
            "method": "POST",
            "permission": "family.edit"
          },
          {
            "path": "/dates/:id",
            "method": "PATCH",
            "permission": "family.edit"
          },
          {
            "path": "/dates/:id",
            "method": "DELETE",
            "permission": "family.edit"
          },
          {
            "path": "/lists",
            "method": "GET",
            "permission": "family.view"
          },
          {
            "path": "/lists",
            "method": "POST",
            "permission": "family.edit"
          },
          {
            "path": "/lists/:id",
            "method": "PATCH",
            "permission": "family.edit"
          },
          {
            "path": "/lists/:id",
            "method": "DELETE",
            "permission": "family.edit"
          },
          {
            "path": "/lists/:id/items",
            "method": "GET",
            "permission": "family.view"
          },
          {
            "path": "/lists/:id/items",
            "method": "POST",
            "permission": "family.edit"
          },
          {
            "path": "/items/:id",
            "method": "PATCH",
            "permission": "family.edit"
          },
          {
            "path": "/items/:id/complete",
            "method": "POST",
            "permission": "family.edit"
          },
          {
            "path": "/items/:id",
            "method": "DELETE",
            "permission": "family.edit"
          },
          {
            "path": "/chores/tally",
            "method": "GET",
            "permission": "family.view"
          },
          {
            "path": "/preferences",
            "method": "GET",
            "permission": "family.view"
          },
          {
            "path": "/preferences",
            "method": "POST",
            "permission": "family.edit"
          },
          {
            "path": "/preferences/:id",
            "method": "PATCH",
            "permission": "family.edit"
          },
          {
            "path": "/preferences/:id",
            "method": "DELETE",
            "permission": "family.edit"
          },
          {
            "path": "/wishlist",
            "method": "GET",
            "permission": "family.view"
          },
          {
            "path": "/wishlist",
            "method": "POST",
            "permission": "family.edit"
          },
          {
            "path": "/wishlist/:id",
            "method": "PATCH",
            "permission": "family.edit"
          },
          {
            "path": "/wishlist/:id",
            "method": "DELETE",
            "permission": "family.edit"
          },
          {
            "path": "/wishlist/:id/claim",
            "method": "POST",
            "permission": "family.edit"
          },
          {
            "path": "/wishlist/:id/claim",
            "method": "DELETE",
            "permission": "family.edit"
          },
          {
            "path": "/gift-ideas",
            "method": "GET",
            "permission": "family.view"
          },
          {
            "path": "/gift-ideas",
            "method": "POST",
            "permission": "family.edit"
          },
          {
            "path": "/gift-ideas/:id",
            "method": "PATCH",
            "permission": "family.edit"
          },
          {
            "path": "/gift-ideas/:id",
            "method": "DELETE",
            "permission": "family.edit"
          },
          {
            "path": "/gift-context",
            "method": "GET",
            "permission": "family.view"
          },
          {
            "path": "/settings",
            "method": "GET",
            "permission": "family.view"
          },
          {
            "path": "/settings",
            "method": "PATCH",
            "permission": "family.manage"
          },
          {
            "path": "/settings/me",
            "method": "PUT",
            "permission": "family.edit"
          }
        ]
      }
    }
  ],
  "mcp_servers": {
    "family": {
      "command": "ryu-family",
      "args": ["mcp"],
      "description": "Family hub tools for upcoming dates, people, shared lists and chores, family-visible preferences and wishlists, and gift context. Gift ideas and wishlist claims are never exposed through these tools."
    }
  },
  "permission_grants": ["app:http", "mcp:family"],
  "permission_levels": [
    {
      "id": "family.view",
      "label": "Can view",
      "description": "See family people, dates, lists, preferences, wishlists, and the gift ideas visible to them."
    },
    {
      "id": "family.edit",
      "label": "Can edit",
      "description": "Add and change family records, check off list items, claim wishlist items, and keep gift ideas.",
      "implies": ["family.view"]
    },
    {
      "id": "family.manage",
      "label": "Can manage",
      "description": "Change the family hub's time zone, reminder timing, currency, and family agent access.",
      "implies": ["family.edit"]
    }
  ],
  "companion": {
    "label": "Family",
    "icon": "user-love-01"
  },
  "contributes": {
    "agents": [
      {
        "id": "family-agent"
      }
    ],
    "sidebar_buttons": [
      {
        "id": "family-upcoming",
        "title": "Upcoming",
        "icon": "calendar-04",
        "target": "/plugin/app__family-companion",
        "context": {
          "tab": "upcoming"
        },
        "order": 100
      },
      {
        "id": "family-people",
        "title": "People & dates",
        "icon": "user-group-02",
        "target": "/plugin/app__family-companion",
        "context": {
          "tab": "people"
        },
        "order": 101
      },
      {
        "id": "family-lists",
        "title": "Lists",
        "icon": "check-list",
        "target": "/plugin/app__family-companion",
        "context": {
          "tab": "lists"
        },
        "order": 102
      },
      {
        "id": "family-wishlists",
        "title": "Wishlists",
        "icon": "gift-card",
        "target": "/plugin/app__family-companion",
        "context": {
          "tab": "wishlists"
        },
        "order": 103
      },
      {
        "id": "family-gifts",
        "title": "Gift ideas",
        "icon": "gift",
        "target": "/plugin/app__family-companion",
        "context": {
          "tab": "gifts"
        },
        "order": 104
      },
      {
        "id": "family-settings",
        "title": "Settings",
        "icon": "settings-01",
        "target": "/plugin/app__family-companion",
        "context": {
          "tab": "settings"
        },
        "order": 105
      }
    ]
  }
}

{
  "tags": ["chat", "broadcast", "announcements", "multi-chat"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-chat-broadcast",
  "homepage": "https://github.com/amajorai/ryu-chat-broadcast",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/chat-broadcast",
  "name": "Chat Broadcast",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Productivity",
  "description": "Send one message to every running chat or a hand-picked set of visible chats, including idle conversations.",
  "tagline": "Change direction across many chats at once",
  "keywords": [
    "chat",
    "broadcast",
    "announcement",
    "multi-chat",
    "coordination"
  ],
  "icon": "message-multiple-01",
  "iconDither": { "from": 198, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "none" },
    "mobile": { "support": "none" },
    "extension": { "support": "none" },
    "web": { "support": "none" },
    "cli": { "support": "none" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "chat-broadcast-companion",
      "name": "Chat Broadcast",
      "kind": "companion",
      "config": {
        "label": "Chat Broadcast",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": ["chat.sendFollowUp"],
  "permission_levels": [
    {
      "id": "chat-broadcast.send",
      "label": "Can broadcast",
      "description": "List the chats you can access and send a confirmed message into selected conversations, including idle chats."
    }
  ],
  "companion": {
    "label": "Chat Broadcast",
    "icon": "message-multiple-01"
  },
  "contributes": {
    "sidebar_buttons": [
      {
        "id": "chat-broadcast",
        "title": "Chat Broadcast",
        "icon": "hugeicons:message-multiple-01",
        "target": "/chat-broadcast",
        "order": 44
      }
    ],
    "chat_widget_templates": [
      {
        "id": "chat-broadcast.chat",
        "title": "Chat Broadcast widget",
        "description": "Chat Broadcast chat widget metadata is coming soon; no render tool is available yet.",
        "triggers": ["chat broadcast widget"],
        "examples": ["Show me a chat broadcast widget"],
        "backing": {},
        "display_mode": "inline",
        "safe_action_ids": [],
        "availability": "coming-soon"
      }
    ]
  }
}

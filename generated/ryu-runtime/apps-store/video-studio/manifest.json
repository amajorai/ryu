{
  "id": "@ryu/video-studio",
  "name": "Video Studio",
  "version": "0.1.15",
  "stability": "experimental",
  "author": {
    "name": "Ryu",
    "url": "https://ryuhq.com"
  },
  "description": "Edit layered video timelines, review storyboards, add timed captions, and render finished videos on your Ryu node.",
  "tagline": "From your first cut to the finished film",
  "category": "Creative",
  "icon": "film-01",
  "iconDither": { "from": 327, "to": "transparent", "direction": "down" },
  "tags": ["video", "editing", "timeline", "production"],
  "keywords": [
    "video",
    "editor",
    "timeline",
    "storyboard",
    "captions",
    "render"
  ],
  "repository": "https://github.com/amajorai/ryu-video-studio",
  "homepage": "https://github.com/amajorai/ryu-video-studio",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "engines": {
    "ryu": ">=0.1.0"
  },
  "surfaces": {
    "gateway": {
      "support": "none"
    },
    "core": {
      "support": "full"
    },
    "desktop": {
      "support": "full"
    },
    "island": {
      "support": "none"
    },
    "mobile": {
      "support": "none"
    },
    "extension": {
      "support": "none"
    },
    "web": {
      "support": "none"
    },
    "cli": {
      "support": "none"
    }
  },
  "permission_grants": [
    "app:http",
    "media:generate",
    "hook:side-model",
    "media:transcribe",
    "spaces:docs",
    "usage:read"
  ],
  "optional_permission_grants": [
    "usage:audit",
    "chat.sendFollowUp",
    "media:record",
    "core:list_agents",
    "social:crud"
  ],

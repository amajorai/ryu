{
  "tags": [
    "feedback",
    "product",
    "roadmap",
    "feature requests",
    "voting",
    "changelog",
    "ai"
  ],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-feedback-board",
  "homepage": "https://github.com/amajorai/ryu-feedback-board",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/feedback-board",
  "name": "Feedback Board",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Productivity",
  "description": "A public feedback board and private Ryu product workspace: collect requests, votes, and comments, turn demand into a roadmap, and use configurable Ryu workflows to prepare or build what users ask for.",
  "tagline": "Listen in public. Build with Ryu.",
  "keywords": [
    "feedback",
    "feature requests",
    "roadmap",
    "voting",
    "product management",
    "changelog",
    "ai"
  ],
  "icon": "comment-01",
  "iconDither": { "from": 211, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "limited" },
    "cli": { "support": "list" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "requires": {
    "apps": [{ "id": "@ryu/spaces" }],
    "grants": ["spaces:docs"]
  },
  "runnables": [
    {
      "id": "feedback-board-companion",
      "name": "Feedback Board",
      "kind": "companion",
      "config": {
        "label": "Feedback Board",
        "ui_entry": "./ui/dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "sidecars": [
    {
      "name": "feedback-board",
      "process": {
        "kind": "local",
        "command": "ryu-feedback-board",
        "command_env": "RYU_FEEDBACK_BOARD_BIN",
        "port_env": "RYU_FEEDBACK_BOARD_PORT"
      },
      "port": 8076,
      "health_path": "/health",
      "lazy": true,
      "idle_stop_secs": 900,
      "http": {
        "mount": "/api/feedback-board",
        "public_mount": "/feedback",
        "max_body_bytes": 262144,
        "routes": [
          {
            "path": "/admin/workspace",
            "method": "GET",
            "permission": "feedback-board.view"
          },
          {
            "path": "/admin/workspace",
            "method": "PUT",
            "permission": "feedback-board.manage"
          },
          {
            "path": "/admin/boards",
            "method": "GET",
            "permission": "feedback-board.view"
          },
          {
            "path": "/admin/boards",
            "method": "POST",
            "permission": "feedback-board.manage"
          },
          {
            "path": "/admin/boards/:boardId",
            "method": "PUT",
            "permission": "feedback-board.manage"
          },
          {
            "path": "/admin/requests",
            "method": "GET",
            "permission": "feedback-board.view"
          },
          {
            "path": "/admin/requests/:requestId",
            "method": "GET",
            "permission": "feedback-board.view"
          },
          {
            "path": "/admin/requests/:requestId",
            "method": "PUT",
            "permission": "feedback-board.manage"
          },
          {
            "path": "/admin/requests/:requestId/triage",
            "method": "POST",
            "permission": "feedback-board.manage"
          },
          {
            "path": "/admin/requests/:requestId/merge",
            "method": "POST",
            "permission": "feedback-board.manage"
          },
          {
            "path": "/admin/requests/:requestId/brief",
            "method": "POST",
            "permission": "feedback-board.manage"
          },
          {
            "path": "/admin/requests/:requestId/automation",
            "method": "GET",
            "permission": "feedback-board.view"
          },
          {
            "path": "/admin/requests/:requestId/automation/run",
            "method": "POST",
            "permission": "feedback-board.build"
          },
          {
            "path": "/admin/requests/:requestId/automation/:runId/resume",
            "method": "POST",
            "permission": "feedback-board.build"
          },
          {
            "path": "/admin/automation/runs/:runId",
            "method": "GET",
            "permission": "feedback-board.view"
          },
          {
            "path": "/admin/roadmap",
            "method": "GET",
            "permission": "feedback-board.view"
          },
          {
            "path": "/admin/changelog",
            "method": "GET",
            "permission": "feedback-board.view"
          },
          {
            "path": "/admin/changelog/drafts",
            "method": "POST",
            "permission": "feedback-board.manage"
          },
          {
            "path": "/admin/changelog/:releaseId/publish",
            "method": "POST",
            "permission": "feedback-board.manage"
          },
          { "path": "/:boardSlug", "method": "GET", "auth": "public" },
          {
            "path": "/:boardSlug/requests",
            "method": "GET",
            "auth": "public"
          },
          {
            "path": "/:boardSlug/requests/:requestId",
            "method": "GET",
            "auth": "public"
          },
          {
            "path": "/:boardSlug/requests",
            "method": "POST",
            "auth": "public"
          },
          {
            "path": "/:boardSlug/requests/:requestId/vote",
            "method": "POST",
            "auth": "public"
          },
          {
            "path": "/:boardSlug/requests/:requestId/comments",
            "method": "POST",
            "auth": "public"
          },
          {
            "path": "/:boardSlug/roadmap",
            "method": "GET",
            "auth": "public"
          },
          {
            "path": "/:boardSlug/changelog",
            "method": "GET",
            "auth": "public"
          },
          {
            "path": "/:boardSlug/changelog/:releaseId",
            "method": "GET",
            "auth": "public"
          }
        ]
      }
    }
  ],
  "permission_grants": [
    "app:http",
    "storage:kv",
    "spaces:docs",
    "shell:integrate",
    "hook:side-model",
    "hook:run-agent",
    "core:list_agents",
    "workflows:crud",
    "workflows:runstate",
    "workflows:catalogs",
    "blueprint:review"
  ],
  "permission_levels": [
    {
      "id": "feedback-board.view",
      "label": "Can view",
      "description": "Browse the private feedback inbox, roadmap, changelog drafts, and automation history."
    },
    {
      "id": "feedback-board.manage",
      "label": "Can manage",
      "description": "Moderate public feedback, change requests and roadmap state, and publish changelog updates.",
      "implies": ["feedback-board.view"]
    },
    {
      "id": "feedback-board.build",
      "label": "Can run builds",
      "description": "Start, resume, and inspect Ryu workflows that prepare or build a feature request.",
      "implies": ["feedback-board.manage"]
    }
  ],
  "companion": {
    "label": "Feedback Board",
    "icon": "comment-01"
  },
  "contributes": {
    "sidebar_buttons": [
      {
        "id": "feedback-board-overview",
        "title": "Overview",
        "icon": "dashboard-square-02",
        "target": "/feedback-board",
        "context": { "view": "overview" },
        "order": 58
      },
      {
        "id": "feedback-board-requests",
        "title": "Requests",
        "icon": "comment-01",
        "target": "/feedback-board",
        "context": { "view": "requests" },
        "order": 59
      },
      {
        "id": "feedback-board-roadmap",
        "title": "Roadmap",
        "icon": "roadmap",
        "target": "/feedback-board",
        "context": { "view": "roadmap" },
        "order": 60
      },
      {
        "id": "feedback-board-changelog",
        "title": "Changelog",
        "icon": "note-01",
        "target": "/feedback-board",
        "context": { "view": "changelog" },
        "order": 61
      },
      {
        "id": "feedback-board-automation",
        "title": "Automation",
        "icon": "automation-02",
        "target": "/feedback-board",
        "context": { "view": "automation" },
        "order": 62
      },
      {
        "id": "feedback-board-settings",
        "title": "Settings",
        "icon": "settings-01",
        "target": "/feedback-board",
        "context": { "view": "settings" },
        "order": 63
      }
    ]
  }
}

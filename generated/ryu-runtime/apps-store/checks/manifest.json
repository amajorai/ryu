{
  "tags": [
    "testing",
    "quality",
    "e2e",
    "ui testing",
    "api testing",
    "regression"
  ],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-checks",
  "homepage": "https://github.com/amajorai/ryu-checks",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/checks",
  "name": "Tests",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Developer Tools",
  "description": "A local-first verification workspace for planning, running, and reviewing UI, API, and agent-driven tests from one Ryu surface.",
  "tagline": "Turn every change into evidence",
  "keywords": ["testing", "quality", "e2e", "regression", "playwright", "api"],
  "icon": "test-tube",
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "limited" },
    "cli": { "support": "list" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "permission_grants": ["core:list_agents"],
  "runnables": [
    {
      "id": "checks-companion",
      "name": "Tests",
      "kind": "companion",
      "config": {
        "label": "Tests",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "companion": {
    "label": "Tests",
    "icon": "test-tube"
  },
  "contributes": {
    "sidebar_buttons": [
      {
        "id": "checks-home",
        "title": "Home",
        "icon": "home-01",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "home" },
        "order": 40
      },
      {
        "id": "checks-all",
        "title": "All Tests",
        "icon": "test-tube",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "all-tests" },
        "order": 41
      },
      {
        "id": "checks-web",
        "title": "Web Tests",
        "icon": "browser",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "all-tests-ui" },
        "order": 42
      },
      {
        "id": "checks-api",
        "title": "API Tests",
        "icon": "api",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "all-tests-api" },
        "order": 43
      },
      {
        "id": "checks-create",
        "title": "Create Tests",
        "icon": "add-01",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "create-tests" },
        "order": 44
      },
      {
        "id": "checks-lists",
        "title": "Test Lists",
        "icon": "package",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "test-lists" },
        "order": 45
      },
      {
        "id": "checks-monitoring",
        "title": "Monitoring",
        "icon": "clock-01",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "monitoring" },
        "order": 46
      },
      {
        "id": "checks-settings-api",
        "title": "API Keys",
        "icon": "key-01",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "settings-api-keys" },
        "order": 47
      },
      {
        "id": "checks-settings-github",
        "title": "GitHub App",
        "icon": "github",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "settings-github" },
        "order": 48
      }
    ],
    "chat_widget_templates": [
      {
        "id": "checks.chat",
        "title": "Tests widget",
        "description": "Tests chat widget metadata is coming soon; no render tool is available yet.",
        "triggers": ["tests widget"],
        "examples": ["Show me a tests widget"],
        "backing": {},
        "display_mode": "inline",
        "safe_action_ids": [],
        "availability": "coming-soon"
      }
    ]
  }
}

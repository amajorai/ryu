{
  "tags": [
    "testing",
    "quality",
    "e2e",
    "ui testing",
    "api testing",
    "regression"
  ],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-checks",
  "homepage": "https://github.com/amajorai/ryu-checks",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/checks",
  "name": "Tests",
  "version": "0.1.1",
  "stability": "experimental",
  "category": "Developer Tools",
  "description": "A node-local agentic verification workspace for exploring live targets, generating UI/API plans, running evidence-backed checks, and keeping failure bundles, collections, schedules, and coverage in one place.",
  "tagline": "Turn every change into evidence",
  "keywords": ["testing", "quality", "e2e", "regression", "playwright", "api"],
  "icon": "test-tube",
  "iconDither": { "from": 174, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "limited" },
    "cli": { "support": "full" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "permission_grants": [
    "app:http",
    "tool:http-egress:127.0.0.1",
    "core:list_agents",
    "hook:side-model",
    "hook:run-agent",
    "mcp:checks",
    "authorization:defer",
    "browser:control"
  ],
  "requires": {
    "capabilities": [
      { "capability": "browser.control", "min_version": "1.0.0" }
    ],
    "grants": ["browser:control"]
  },
  "runnables": [
    {
      "id": "checks-companion",
      "name": "Tests",
      "kind": "companion",
      "config": {
        "label": "Tests",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    },
    {
      "id": "tool-checks-run-project",
      "name": "Run Checks Project",
      "kind": "tool",
      "config": {
        "slug": "checks.run_project",
        "backend": "http",
        "method": "POST",
        "url": "core:/api/ext/@ryu/checks/tools/run_project",
        "secret_headers": { "Authorization": "Bearer env:RYU_TOKEN" },
        "fail_open": true,
        "unwrap_body": true,
        "description": "Run one persisted Checks project against its live target and return the retained verdict, evidence level, and failure bundles. Use this from an agent or CI bridge when the Companion is not the right entry point.",
        "input_schema": {
          "type": "object",
          "required": ["project_id"],
          "properties": {
            "project_id": {
              "type": "string",
              "description": "Stable Checks project id."
            },
            "trigger": {
              "type": "string",
              "description": "Run provenance such as agent, ci, or manual."
            }
          }
        }
      }
    },
    {
      "id": "tool-checks-analytics",
      "name": "Checks Analytics",
      "kind": "tool",
      "config": {
        "slug": "checks.analytics",
        "backend": "http",
        "method": "GET",
        "url": "core:/api/ext/@ryu/checks/tools/analytics",
        "secret_headers": { "Authorization": "Bearer env:RYU_TOKEN" },
        "fail_open": true,
        "unwrap_body": true,
        "description": "Read node-local Checks totals, coverage, and failure buckets for release or agent summaries.",
        "input_schema": { "type": "object", "properties": {} }
      }
    }
  ],
  "mcp_servers": {
    "checks": {
      "command": "ryu-checks",
      "args": ["mcp"],
      "description": "Run persisted Checks projects or read node-local analytics from an IDE or coding agent. The MCP server shares the Companion's sidecar store and evidence contract."
    }
  },
  "sidecars": [
    {
      "name": "checks",
      "process": {
        "kind": "local",
        "command": "ryu-checks",
        "command_env": "RYU_CHECKS_BIN",
        "port_env": "RYU_CHECKS_PORT"
      },
      "port": 8042,
      "health_path": "/health",
      "lazy": true,
      "idle_stop_secs": 900,
      "host_api": { "grants": ["authorization:defer", "crypto:seal"] },
      "http": {
        "mount": "/api/checks",
        "public_mount": "/api/checks",
        "max_body_bytes": 262144,
        "routes": [
          {
            "path": "/bootstrap",
            "method": "GET",
            "permission": "checks.view"
          },
          {
            "path": "/analytics",
            "method": "GET",
            "permission": "checks.view"
          },
          { "path": "/projects", "method": "GET", "permission": "checks.view" },
          {
            "path": "/projects",
            "method": "POST",
            "permission": "checks.manage"
          },
          {
            "path": "/projects/:id",
            "method": "GET",
            "permission": "checks.view"
          },
          {
            "path": "/projects/:id",
            "method": "DELETE",
            "permission": "checks.manage"
          },
          {
            "path": "/projects/:id/agent-runs",
            "method": "GET",
            "permission": "checks.view"
          },
          {
            "path": "/projects/:id/agent-runs",
            "method": "POST",
            "permission": "checks.run"
          },
          {
            "path": "/tests/:id",
            "method": "PATCH",
            "permission": "checks.manage"
          },
          {
            "path": "/tests/:id/run",
            "method": "POST",
            "permission": "checks.run"
          },
          {
            "path": "/projects/:id/explore",
            "method": "POST",
            "permission": "checks.run"
          },
          {
            "path": "/projects/:id/runs",
            "method": "GET",
            "permission": "checks.view"
          },
          {
            "path": "/projects/:id/runs",
            "method": "POST",
            "permission": "checks.run"
          },
          { "path": "/runs/:id", "method": "GET", "permission": "checks.view" },
          {
            "path": "/evidence/:id",
            "method": "GET",
            "permission": "checks.view"
          },
          {
            "path": "/runs/:id/failures/:failure_id/heal",
            "method": "POST",
            "permission": "checks.manage"
          },
          {
            "path": "/tools/run_project",
            "method": "POST",
            "permission": "checks.run"
          },
          {
            "path": "/tools/analytics",
            "method": "GET",
            "permission": "checks.view"
          },
          { "path": "/lists", "method": "GET", "permission": "checks.view" },
          { "path": "/lists", "method": "POST", "permission": "checks.manage" },
          {
            "path": "/lists/:id",
            "method": "PATCH",
            "permission": "checks.manage"
          },
          {
            "path": "/lists/:id/runs",
            "method": "POST",
            "permission": "checks.run"
          },
          {
            "path": "/schedules",
            "method": "GET",
            "permission": "checks.view"
          },
          {
            "path": "/schedules",
            "method": "POST",
            "permission": "checks.manage"
          },
          {
            "path": "/schedules/:id",
            "method": "PATCH",
            "permission": "checks.manage"
          },
          {
            "path": "/schedules/:id",
            "method": "DELETE",
            "permission": "checks.manage"
          },
          {
            "path": "/schedules/:id/run",
            "method": "POST",
            "permission": "checks.run"
          }
        ]
      }
    }
  ],
  "permission_levels": [
    {
      "id": "checks.view",
      "label": "Can view verification evidence",
      "description": "Read projects, plans, runs, evidence, collections, schedules, and analytics."
    },
    {
      "id": "checks.run",
      "label": "Can run live checks",
      "description": "Explore a target and execute node-local verification runs against it.",
      "implies": ["checks.view"]
    },
    {
      "id": "checks.manage",
      "label": "Can manage verification plans",
      "description": "Create and remove projects, collections, and schedules.",
      "implies": ["checks.view"]
    }
  ],
  "companion": {
    "label": "Tests",
    "icon": "test-tube"
  },
  "contributes": {
    "sidebar_buttons": [
      {
        "id": "checks-home",
        "title": "Home",
        "icon": "home-01",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "home" },
        "order": 40
      },
      {
        "id": "checks-all",
        "title": "All Tests",
        "icon": "test-tube",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "all-tests" },
        "order": 41
      },
      {
        "id": "checks-web",
        "title": "Web Tests",
        "icon": "browser",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "all-tests-ui" },
        "order": 42
      },
      {
        "id": "checks-api",
        "title": "API Tests",
        "icon": "api",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "all-tests-api" },
        "order": 43
      },
      {
        "id": "checks-create",
        "title": "Create Tests",
        "icon": "add-01",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "create-tests" },
        "order": 44
      },
      {
        "id": "checks-lists",
        "title": "Test Lists",
        "icon": "package",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "test-lists" },
        "order": 45
      },
      {
        "id": "checks-monitoring",
        "title": "Monitoring",
        "icon": "clock-01",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "monitoring" },
        "order": 46
      },
      {
        "id": "checks-settings-api",
        "title": "API Keys",
        "icon": "key-01",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "settings-api-keys" },
        "order": 47
      },
      {
        "id": "checks-settings-github",
        "title": "GitHub App",
        "icon": "github",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "settings-github" },
        "order": 48
      },
      {
        "id": "checks-settings-capabilities",
        "title": "Capabilities",
        "icon": "activity",
        "target": "/plugin/app__checks-companion",
        "context": { "screen": "settings-capabilities" },
        "order": 49
      }
    ]
  }
}

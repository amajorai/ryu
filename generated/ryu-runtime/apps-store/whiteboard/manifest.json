{
  "tags": ["whiteboard", "drawing", "diagrams", "excalidraw"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-whiteboard",
  "homepage": "https://github.com/amajorai/ryu-whiteboard",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/whiteboard",
  "name": "Whiteboard",
  "version": "0.1.15",
  "stability": "experimental",
  "description": "An Excalidraw whiteboard shipped as a Ryu app: draw, diagram, and rearrange freely, insert attributed Openverse or node-configured Unsplash images, and use Mermaid-to-Excalidraw to import a diagram straight from text. Each board persists as a Space document, so it stays editable, shareable, and searchable.",
  "tagline": "Draw, diagram, and add sourced images",
  "keywords": ["whiteboard", "drawing", "diagrams", "excalidraw"],
  "category": "Creative",
  "icon": "shapes",
  "iconDither": { "from": 2, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "whiteboard-companion",
      "name": "Whiteboard",
      "kind": "companion",
      "config": {
        "label": "Whiteboard",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "requires": {
    "apps": [
      {
        "id": "@ryu/spaces"
      }
    ],
    "grants": ["spaces:docs"]
  },
  "permission_grants": [
    "spaces:docs",
    "hook:side-model",
    "core:list_agents",
    "app:realtime",
    "ui:toast",
    "ui:declarative-http"
  ],
  "permission_levels": [
    {
      "id": "whiteboard.view",
      "label": "Can view",
      "description": "Open whiteboards and read what is on them."
    },
    {
      "id": "whiteboard.edit",
      "label": "Can edit",
      "description": "Draw on, rearrange, and delete whiteboards, including the documents they store in Spaces.",
      "implies": ["whiteboard.view"]
    }
  ],
  "companion": {
    "label": "Whiteboard",
    "icon": "shapes"
  },
  "contributes": {
    "sidebar_sections": [
      {
        "id": "whiteboard",
        "title": "Whiteboard",
        "icon": "shapes",
        "spec": {
          "source": {
            "http": {
              "method": "GET",
              "path": "/api/apps/@ryu/whiteboard/docs"
            },
            "items": "documents"
          },
          "itemTarget": "/spaces/{{item.space_id}}/app/@ryu/whiteboard/{{item.id}}",
          "create": {
            "http": {
              "method": "POST",
              "path": "/api/apps/@ryu/whiteboard/docs"
            },
            "targetFrom": "id",
            "label": "New whiteboard"
          },
          "itemActions": [
            {
              "id": "delete",
              "label": "Delete",
              "icon": "lucide:trash-2",
              "style": "danger",
              "http": {
                "method": "DELETE",
                "path": "/api/spaces/{{item.space_id}}/documents/{{item.id}}"
              }
            }
          ]
        }
      }
    ]
  }
}

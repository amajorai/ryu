{
  "tags": ["payments", "mpp", "tempo", "services", "receipts"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-mpp",
  "homepage": "https://mpp.dev",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/mpp",
  "name": "Payments",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Developer Tools",
  "description": "Discover services that speak the Machine Payments Protocol, review exact Tempo testnet charges, enforce per-request and daily budgets, make explicitly approved paid requests, and keep a local receipt ledger. Signing keys use Ryu's per-app encrypted custody and never enter chat, app state, logs, or receipt records.",
  "tagline": "Governed machine payments with receipts you can audit",
  "keywords": ["payments", "mpp", "tempo", "services", "receipts"],
  "icon": "wallet-cards",
  "iconDither": { "from": 156, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "limited" },
    "cli": { "support": "list" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "mpp-companion",
      "name": "Payments",
      "kind": "companion",
      "config": {
        "label": "Payments",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    },
    {
      "id": "tool-mpp-services-search",
      "name": "Search MPP services",
      "kind": "tool",
      "config": {
        "slug": "mpp.services_search",
        "backend": "http",
        "method": "POST",
        "url": "core:/api/ext/@ryu/mpp/tools/services_search",
        "secret_headers": { "Authorization": "Bearer env:RYU_TOKEN" },
        "fail_open": true,
        "unwrap_body": true,
        "description": "Search the official mpp.dev service catalog. This is read-only and returns service names, descriptions, HTTPS URLs, categories, endpoints, and advertised prices when present.",
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Optional text to match across service names, descriptions, URLs, and categories."
            }
          }
        }
      }
    },
    {
      "id": "tool-mpp-wallet-status",
      "name": "Check MPP wallet and budget",
      "kind": "tool",
      "config": {
        "slug": "mpp.wallet_status",
        "backend": "http",
        "method": "POST",
        "url": "core:/api/ext/@ryu/mpp/tools/wallet_status",
        "secret_headers": { "Authorization": "Bearer env:RYU_TOKEN" },
        "fail_open": true,
        "unwrap_body": true,
        "description": "Read the safe wallet projection, active payment policy, and today's spent, pending, and available pathUSD budget. Private keys are never returned.",
        "input_schema": { "type": "object", "properties": {} }
      }
    },
    {
      "id": "tool-mpp-payment-prepare",
      "name": "Prepare an MPP request",
      "kind": "tool",
      "config": {
        "slug": "mpp.payment_prepare",
        "backend": "http",
        "method": "POST",
        "url": "core:/api/ext/@ryu/mpp/tools/payment_prepare",
        "secret_headers": { "Authorization": "Bearer env:RYU_TOKEN" },
        "fail_open": false,
        "unwrap_body": true,
        "description": "Probe an allowlisted HTTPS endpoint for an MPP challenge and return an approval-safe summary. This does not sign or send a payment. If payment is required, pass the one-time approval token to mpp.pay only after the user reviews the exact amount, network, currency, recipient, expiry, and budget delta.",
        "input_schema": {
          "type": "object",
          "required": ["method", "url"],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"]
            },
            "url": {
              "type": "string",
              "description": "Allowlisted HTTPS resource URL."
            },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "Optional safe request headers. Authorization and payment credential headers are forbidden."
            },
            "body": {
              "type": "string",
              "description": "Optional request body, up to 256 KiB."
            },
            "idempotencyKey": {
              "type": "string",
              "description": "Optional stable idempotency key for this exact purchase."
            }
          }
        }
      }
    },
    {
      "id": "tool-mpp-pay",
      "name": "Approve and pay an MPP request",
      "kind": "tool",
      "config": {
        "slug": "mpp.pay",
        "backend": "http",
        "method": "POST",
        "url": "core:/api/ext/@ryu/mpp/tools/payment_pay",
        "secret_headers": { "Authorization": "Bearer env:RYU_TOKEN" },
        "fail_open": false,
        "unwrap_body": true,
        "description": "Spend funds for a previously prepared MPP challenge. This is a financial action: obtain explicit approval immediately before calling it. The one-time token is challenge-bound and expires after five minutes or sooner when the server challenge expires.",
        "input_schema": {
          "type": "object",
          "required": ["approvalToken"],
          "properties": {
            "approvalToken": {
              "type": "string",
              "description": "One-time token returned by mpp.payment_prepare after the exact charge was reviewed."
            }
          }
        }
      }
    },
    {
      "id": "tool-mpp-mcp-payment-prepare",
      "name": "Prepare a paid MCP tool call",
      "kind": "tool",
      "config": {
        "slug": "mpp.mcp_payment_prepare",
        "backend": "http",
        "method": "POST",
        "url": "core:/api/ext/@ryu/mpp/tools/mcp_payment_prepare",
        "secret_headers": { "Authorization": "Bearer env:RYU_TOKEN" },
        "fail_open": false,
        "unwrap_body": true,
        "description": "Call an allowlisted remote MCP tool without a payment credential and capture a standard MPP payment-required error or result metadata. This never signs a payment. Review the returned exact charge, then pass its one-time approval token to mpp.pay.",
        "input_schema": {
          "type": "object",
          "required": ["url", "tool"],
          "properties": {
            "url": {
              "type": "string",
              "description": "Allowlisted HTTPS Streamable HTTP MCP server URL."
            },
            "tool": { "type": "string", "description": "MCP tool name." },
            "arguments": {
              "type": "object",
              "description": "JSON object passed to the MCP tool."
            },
            "idempotencyKey": {
              "type": "string",
              "description": "Optional stable idempotency key for this exact purchase."
            }
          }
        }
      }
    },
    {
      "id": "tool-mpp-receipts-list",
      "name": "List MPP receipts",
      "kind": "tool",
      "config": {
        "slug": "mpp.receipts_list",
        "backend": "http",
        "method": "POST",
        "url": "core:/api/ext/@ryu/mpp/tools/receipts_list",
        "secret_headers": { "Authorization": "Bearer env:RYU_TOKEN" },
        "fail_open": true,
        "unwrap_body": true,
        "description": "List safe local receipt projections in newest-first order. Credentials, proofs, request bodies, and signing keys are never stored or returned.",
        "input_schema": {
          "type": "object",
          "properties": {
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        }
      }
    },
    {
      "id": "tool-mpp-receipt-get",
      "name": "Get an MPP receipt",
      "kind": "tool",
      "config": {
        "slug": "mpp.receipt_get",
        "backend": "http",
        "method": "POST",
        "url": "core:/api/ext/@ryu/mpp/tools/receipt_get",
        "secret_headers": { "Authorization": "Bearer env:RYU_TOKEN" },
        "fail_open": true,
        "unwrap_body": true,
        "description": "Read one safe local receipt projection by id.",
        "input_schema": {
          "type": "object",
          "required": ["receiptId"],
          "properties": { "receiptId": { "type": "string" } }
        }
      }
    }
  ],
  "sidecars": [
    {
      "name": "mpp",
      "process": {
        "kind": "local",
        "command": "ryu-mpp",
        "command_env": "RYU_MPP_BIN",
        "port_env": "RYU_MPP_PORT"
      },
      "host_api": { "grants": ["crypto:seal", "egress:http", "storage:kv"] },
      "port": 8018,
      "health_path": "/health",
      "lazy": true,
      "idle_stop_secs": 300,
      "http": {
        "mount": "/api/mpp",
        "public_mount": "/api/mpp",
        "max_body_bytes": 262144,
        "routes": [
          { "path": "/status" },
          { "path": "/wallet/create" },
          { "path": "/wallet/fund" },
          { "path": "/policy" },
          { "path": "/services" },
          { "path": "/payments/prepare" },
          { "path": "/payments/prepare-mcp" },
          { "path": "/payments/pay" },
          { "path": "/receipts" },
          { "path": "/receipts/:id" },
          { "path": "/tools/services_search" },
          { "path": "/tools/wallet_status" },
          { "path": "/tools/payment_prepare" },
          { "path": "/tools/mcp_payment_prepare" },
          { "path": "/tools/payment_pay" },
          { "path": "/tools/receipts_list" },
          { "path": "/tools/receipt_get" },
          { "path": "/paid/demo", "auth": "public" }
        ]
      }
    }
  ],
  "permission_grants": [
    "app:http",
    "crypto:seal",
    "egress:http",
    "storage:kv",
    "tool:http-egress:127.0.0.1"
  ],
  "contributes": {
    "sidebar_buttons": [
      {
        "id": "mpp-services",
        "title": "Services",
        "icon": "search-01",
        "target": "/plugin/app__mpp-companion",
        "context": { "tab": "services" },
        "order": 30
      },
      {
        "id": "mpp-policy",
        "title": "Policy",
        "icon": "shield-01",
        "target": "/plugin/app__mpp-companion",
        "context": { "tab": "policy" },
        "order": 31
      },
      {
        "id": "mpp-receipts",
        "title": "Receipts",
        "icon": "receipt",
        "target": "/plugin/app__mpp-companion",
        "context": { "tab": "receipts" },
        "order": 32
      }
    ],
    "chat_widget_templates": [
      {
        "id": "mpp.chat",
        "title": "Payments widget",
        "description": "Payments chat widget metadata is coming soon; no render tool is available yet.",
        "triggers": ["payments widget"],
        "examples": ["Show me a payments widget"],
        "backing": {},
        "display_mode": "inline",
        "safe_action_ids": [],
        "availability": "coming-soon"
      }
    ]
  },
  "companion": { "label": "Payments", "icon": "wallet-cards" }
}

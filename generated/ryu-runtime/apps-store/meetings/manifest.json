{
  "tags": ["meetings", "transcription", "notes", "recording"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-meetings",
  "homepage": "https://github.com/amajorai/ryu-meetings",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/meetings",
  "name": "Meetings",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Communication",
  "description": "Meeting notes: record → live transcript → AI notes, auto-saved into the Meetings Space so they stay editable and RAG-searchable.",
  "tagline": "Record, transcribe, and write up your meetings",
  "keywords": ["meetings", "transcription", "notes", "recording"],
  "icon": "mic-01",
  "iconDither": { "from": 318, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "meetings-companion",
      "name": "Meetings",
      "kind": "companion",
      "config": {
        "label": "Meetings",
        "ui_entry": "./dist/index.html",
        "ui_format": "html",
        "csp": {
          "connect_domains": [
            "https://api.iconify.design",
            "https://api.dicebear.com"
          ],
          "resource_domains": [
            "https://api.iconify.design",
            "https://api.dicebear.com"
          ]
        }
      }
    }
  ],
  "sidecars": [
    {
      "name": "ryu-meetings",
      "process": {
        "kind": "local",
        "command": "ryu-meetings",
        "command_env": "RYU_MEETINGS_BIN",
        "port_env": "RYU_MEETINGS_PORT"
      },
      "port": 7998,
      "health_path": "/health",
      "http": {
        "mount": "/api/meetings",
        "public_mount": "/api/meetings",
        "routes": [
          { "path": "/stream", "permission": "meetings.view" },
          { "path": "/detect", "permission": "meetings.record" },
          {
            "path": "/detection-config",
            "method": "GET",
            "permission": "meetings.view"
          },
          {
            "path": "/detection-config",
            "method": "PUT",
            "permission": "meetings.record"
          },
          {
            "path": "/templates",
            "method": "GET",
            "permission": "meetings.view"
          },
          {
            "path": "/templates/select",
            "method": "POST",
            "permission": "meetings.record"
          },
          { "path": "/import", "permission": "meetings.record" },
          { "path": "/", "method": "GET", "permission": "meetings.view" },
          { "path": "/", "method": "POST", "permission": "meetings.record" },
          { "path": "/:id", "method": "GET", "permission": "meetings.view" },
          {
            "path": "/:id",
            "method": "DELETE",
            "permission": "meetings.record"
          },
          { "path": "/:id/title", "permission": "meetings.record" },
          { "path": "/:id/icon", "permission": "meetings.record" },
          { "path": "/:id/chunk", "permission": "meetings.record" },
          { "path": "/:id/finalize", "permission": "meetings.record" },
          {
            "path": "/:id/transcript",
            "method": "GET",
            "permission": "meetings.view"
          }
        ]
      },
      "host_api": {
        "grants": ["spaces:docs"]
      }
    }
  ],
  "requires": {
    "apps": [
      {
        "id": "@ryu/spaces",
        "min_version": "0.1.14"
      }
    ],
    "grants": ["spaces:docs"]
  },
  "permission_grants": [
    "spaces:docs",
    "meetings:crud",
    "ui:toast",
    "ui:declarative-http"
  ],
  "permission_levels": [
    {
      "id": "meetings.view",
      "label": "Can view",
      "description": "Read meeting transcripts and AI notes stored in the Meetings space."
    },
    {
      "id": "meetings.record",
      "label": "Can record",
      "description": "Start and stop meeting capture, which records audio and transcribes everyone in the room.",
      "implies": ["meetings.view"]
    }
  ],
  "companion": {
    "label": "Meetings",
    "icon": "mic-01"
  },
  "contributes": {
    "chat_widget_templates": [
      {
        "id": "meetings.chat",
        "title": "Meetings widget",
        "description": "Open Meetings data in a host-rendered chat widget.",
        "triggers": ["meetings widget"],
        "examples": ["Show me a meetings widget"],
        "backing": { "view_id": "surface:meetings" },
        "display_mode": "inline",
        "safe_action_ids": [],
        "availability": "available"
      }
    ],
    "data_categories": [
      {
        "id": "meetings",
        "title": "Delete all meetings",
        "noun": "meetings",
        "confirm_word": "Meetings",
        "detail": "Every meeting record and its transcript will be permanently deleted."
      }
    ],
    "hook_events": [
      {
        "id": "@ryu/meetings#meeting.started",
        "title": "Meeting started",
        "description": "A meeting record was created and audio ingest began. Fires once per meeting on both paths: a live recording (Shadow capture is starting) and a file import, where it is followed within the same request by the transcription pass and meeting.ended — `app` is \"import\" in that case.",
        "payload_example": {
          "meeting_id": "mtg_9f0c2a1b4d3e4f5a8b7c6d5e4f3a2b1c",
          "title": "Zoom call",
          "app": "zoom",
          "source": "auto",
          "started_at": "2026-08-01T14:02:11Z"
        }
      },
      {
        "id": "@ryu/meetings#meeting.ended",
        "title": "Meeting ended",
        "description": "A meeting was finalized: capture stopped, notes were generated from the transcript, and the auto-title was applied — so the title here is the one the user sees. Fires again if the same meeting is finalized a second time (finalizing is not one-shot), and not at all when note generation failed. The transcript is NOT in the payload; read it from GET /api/meetings/{id}/transcript.",
        "payload_example": {
          "meeting_id": "mtg_9f0c2a1b4d3e4f5a8b7c6d5e4f3a2b1c",
          "title": "Pricing review with Acme",
          "app": "zoom",
          "started_at": "2026-08-01T14:02:11Z",
          "ended_at": "2026-08-01T14:48:03Z",
          "summary": "Acme wants annual billing before the pilot converts.",
          "action_items": ["Send the annual quote by Friday"]
        }
      },
      {
        "id": "@ryu/meetings#notes.ready",
        "title": "Meeting notes filed",
        "description": "The generated notes landed in the Meetings Space as an editable, RAG-searchable document, immediately after meeting.ended. Filing is best-effort, so this does NOT fire when the Space save failed — the notes still exist on the meeting record, they are just not mirrored. Subscribe here (not to meeting.ended) when you need a document to link to.",
        "payload_example": {
          "meeting_id": "mtg_9f0c2a1b4d3e4f5a8b7c6d5e4f3a2b1c",
          "title": "Pricing review with Acme",
          "space_id": "spc_2b1c4d3e5f6a7b8c",
          "doc_id": "doc_7c6d5e4f3a2b1c0d"
        }
      }
    ],
    "settings_tabs": [
      {
        "id": "meetings.settings",
        "title": "Meetings",
        "scope": "node",
        "view": "meetings"
      }
    ],
    "store_tabs": [
      {
        "id": "meeting-templates",
        "title": "Meeting Notes",
        "subtitle": "Note styles tuned to the kind of meeting you're in — pick the one that fits.",
        "icon": "lucide:notebook-pen",
        "group": "catalog",
        "order": 70,
        "spec": {
          "source": {
            "http": { "method": "GET", "path": "/api/meetings/templates" },
            "items": "templates"
          },
          "map": {
            "id": "id",
            "title": "name",
            "description": "description",
            "icon": "icon",
            "tags": "tags",
            "installed": "active"
          },
          "groupBy": "category",
          "groups": [
            { "value": "general", "label": "General" },
            { "value": "recurring", "label": "Team rituals" },
            { "value": "revenue", "label": "Sales & customers" },
            { "value": "hiring", "label": "Hiring" },
            { "value": "delivery", "label": "Delivery" },
            { "value": "research", "label": "Research" },
            { "value": "leadership", "label": "Leadership" }
          ],
          "searchPlaceholder": "Search meeting note styles…",
          "install": {
            "http": {
              "method": "POST",
              "path": "/api/meetings/templates/select",
              "body": { "template_id": "{{item.id}}" }
            },
            "label": "Use",
            "successMessage": "Note style selected"
          },
          "empty": {
            "title": "No note styles found",
            "description": "Try a different search."
          }
        }
      }
    ],
    "sidebar_sections": [
      {
        "id": "meetings",
        "title": "Meetings",
        "icon": "mic-01",
        "spec": {
          "source": {
            "http": { "method": "GET", "path": "/api/meetings" },
            "items": "meetings"
          },
          "itemTarget": "/meetings/{{item.id}}",
          "itemActions": [
            {
              "id": "delete",
              "label": "Delete",
              "icon": "lucide:trash-2",
              "style": "danger",
              "http": {
                "method": "DELETE",
                "path": "/api/meetings/{{item.id}}"
              }
            }
          ]
        }
      }
    ],
    "views": [
      {
        "id": "surface:meetings",
        "title": "Meetings",
        "view": "list-detail",
        "spec": {
          "view": "list-detail",
          "items": [],
          "emptyText": "No meetings yet — record one from the desktop app.",
          "source": {
            "http": { "method": "GET", "path": "/api/meetings" },
            "items": "meetings",
            "map": {
              "subtitle": "created_at",
              "accessory": "status"
            }
          }
        }
      }
    ]
  }
}

{
  "tags": [
    "subtitles",
    "captions",
    "transcription",
    "translation",
    "video",
    "srt",
    "vtt"
  ],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-subtitles",
  "homepage": "https://github.com/amajorai/ryu-subtitles",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/subtitles",
  "name": "Subtitles",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Media & Voice",
  "description": "Pick a video on this machine, transcribe it locally, translate the transcript into the language you want, and get a timed .srt or .vtt written beside the file so your player picks it up. Both model hops stay on the device — local whisper for the transcription, the local gateway's on-device model for the translation — so nothing about the video leaves the disk it is already on. Long jobs are queued and polled, so a feature film keeps working while you do something else.",
  "tagline": "Subtitle any video, in any language, on your own machine",
  "keywords": [
    "subtitles",
    "captions",
    "transcription",
    "translation",
    "video",
    "srt",
    "vtt"
  ],
  "icon": "subtitle",
  "iconDither": { "from": 258, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "none" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "limited" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "subtitles-companion",
      "name": "Subtitles",
      "kind": "companion",
      "config": {
        "label": "Subtitles",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "sidecars": [
    {
      "name": "ryu-subtitles",
      "process": {
        "kind": "local",
        "command": "ryu-subtitles",
        "command_env": "RYU_SUBTITLES_BIN",
        "port_env": "RYU_SUBTITLES_PORT"
      },
      "port": 8013,
      "health_path": "/health",
      "http": {
        "mount": "/api/subtitles",
        "public_mount": "/api/subtitles",
        "routes": [
          { "path": "/languages", "permission": "subtitles.view" },
          { "path": "/roots", "permission": "subtitles.view" },
          { "path": "/library", "permission": "subtitles.view" },
          {
            "path": "/settings",
            "method": "GET",
            "permission": "subtitles.view"
          },
          {
            "path": "/settings",
            "method": "PUT",
            "permission": "subtitles.create"
          },
          { "path": "/jobs", "method": "GET", "permission": "subtitles.view" },
          {
            "path": "/jobs",
            "method": "POST",
            "permission": "subtitles.create"
          },
          {
            "path": "/jobs/:id",
            "method": "GET",
            "permission": "subtitles.view"
          },
          {
            "path": "/jobs/:id",
            "method": "DELETE",
            "permission": "subtitles.create"
          },
          {
            "path": "/jobs/:id/cues",
            "method": "GET",
            "permission": "subtitles.view"
          },
          { "path": "/jobs/:id/download", "permission": "subtitles.view" },
          { "path": "/jobs/:id/retry", "permission": "subtitles.create" },
          { "path": "/jobs/:id/cancel", "permission": "subtitles.create" }
        ]
      }
    }
  ],
  "permission_grants": ["subtitles:crud", "ui:toast", "ui:declarative-http"],
  "permission_levels": [
    {
      "id": "subtitles.view",
      "label": "Can view",
      "description": "See subtitle jobs and download the subtitle files they produced."
    },
    {
      "id": "subtitles.create",
      "label": "Can subtitle videos",
      "description": "Browse this machine's media folders and start subtitle jobs, which read the chosen video file and write a subtitle file beside it.",
      "implies": ["subtitles.view"]
    }
  ],
  "companion": {
    "label": "Subtitles",
    "icon": "subtitle"
  },
  "contributes": {
    "chat_widget_templates": [
      {
        "id": "subtitles.chat",
        "title": "Subtitles widget",
        "description": "Open Subtitles data in a host-rendered chat widget.",
        "triggers": ["subtitles widget"],
        "examples": ["Show me a subtitles widget"],
        "backing": { "view_id": "surface:subtitles" },
        "display_mode": "inline",
        "safe_action_ids": [],
        "availability": "available"
      }
    ],
    "data_categories": [
      {
        "id": "subtitles",
        "title": "Delete all subtitle jobs",
        "noun": "subtitle jobs",
        "confirm_word": "Subtitles",
        "detail": "Every subtitle job, its transcript and the generated files stored by the app will be permanently deleted. Subtitle files already written next to your videos are left alone, and no video is ever touched."
      }
    ],
    "hook_events": [
      {
        "id": "@ryu/subtitles#job.queued",
        "title": "Subtitle job queued",
        "description": "A video was accepted for subtitling and is waiting for the worker. Fires once per job, before any decoding starts — the transcript does not exist yet, so subscribe to `job.completed` if you need the cues.",
        "payload_example": {
          "job_id": "sub_9f0c2a1b4d3e4f5a8b7c6d5e4f3a2b1c",
          "source_name": "Interview.mp4",
          "target_language": "es"
        }
      },
      {
        "id": "@ryu/subtitles#job.completed",
        "title": "Subtitles ready",
        "description": "A subtitle file was written. `output_path` is the copy written beside the source video, and is absent when that could not be written (a read-only volume, or the node setting turned off) — the downloadable copy always exists either way. The cues are NOT in the payload; read them from GET /api/subtitles/jobs/{id}/cues.",
        "payload_example": {
          "job_id": "sub_9f0c2a1b4d3e4f5a8b7c6d5e4f3a2b1c",
          "source_path": "/Users/you/Movies/Interview.mp4",
          "source_name": "Interview.mp4",
          "target_language": "es",
          "format": "srt",
          "cue_count": 842,
          "output_path": "/Users/you/Movies/Interview.es.srt"
        }
      },
      {
        "id": "@ryu/subtitles#job.failed",
        "title": "Subtitle job failed",
        "description": "A job stopped before producing a file, and `error` says why — an unsupported audio codec, a file that moved while queued, or a transcription engine that could not be reached. Does NOT fire when a job merely finished with some lines untranslated; that job completed, and its `translated_count` is lower than its `cue_count`.",
        "payload_example": {
          "job_id": "sub_9f0c2a1b4d3e4f5a8b7c6d5e4f3a2b1c",
          "error": "this file's container or audio codec is not supported: ac3"
        }
      }
    ],
    "sidebar_buttons": [
      {
        "id": "subtitles-new",
        "title": "New subtitles",
        "icon": "subtitle",
        "target": "/subtitles",
        "context": { "section": "new" },
        "order": 86
      },
      {
        "id": "subtitles-jobs",
        "title": "Jobs",
        "icon": "folder-library",
        "target": "/subtitles",
        "context": { "section": "jobs" },
        "order": 87
      },
      {
        "id": "subtitles-settings",
        "title": "Settings",
        "icon": "settings-01",
        "target": "/subtitles",
        "context": { "section": "settings" },
        "order": 88
      }
    ],
    "sidebar_sections": [
      {
        "id": "subtitles",
        "title": "Subtitles",
        "icon": "subtitle",
        "spec": {
          "source": {
            "http": { "method": "GET", "path": "/api/subtitles/jobs" },
            "items": "jobs"
          },
          "itemTarget": "/subtitles/{{item.id}}",
          "itemActions": [
            {
              "id": "delete",
              "label": "Delete",
              "icon": "lucide:trash-2",
              "style": "danger",
              "http": {
                "method": "DELETE",
                "path": "/api/subtitles/jobs/{{item.id}}"
              }
            }
          ]
        }
      }
    ],
    "views": [
      {
        "id": "surface:subtitles",
        "title": "Subtitles",
        "view": "list-detail",
        "spec": {
          "view": "list-detail",
          "items": [],
          "emptyText": "No subtitle jobs yet — open Subtitles and pick a video.",
          "source": {
            "http": { "method": "GET", "path": "/api/subtitles/jobs" },
            "items": "jobs",
            "map": {
              "title": "source_name",
              "subtitle": "stage",
              "accessory": "status"
            }
          }
        }
      }
    ]
  }
}

{
  "tags": ["forms", "surveys", "intake", "submissions", "productivity"],
  "author": {
    "name": "Ryu",
    "url": "https://ryuhq.com"
  },
  "repository": "https://github.com/amajorai/ryu-forms",
  "homepage": "https://github.com/amajorai/ryu-forms",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/forms",
  "name": "Forms",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Productivity",
  "description": "Create shareable forms, collect responses, and export submissions from Ryu.",
  "tagline": "Create forms and collect responses",
  "keywords": ["forms", "surveys", "intake", "feedback", "submissions"],
  "icon": "pencil-edit-02",
  "iconDither": { "from": 24, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "none" },
    "mobile": { "support": "none" },
    "extension": { "support": "none" },
    "web": { "support": "none" },
    "cli": { "support": "none" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "forms-companion",
      "name": "Forms",
      "kind": "companion",
      "config": {
        "label": "Forms",
        "ui_entry": "./sidecar/bundle/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": ["app:http", "crypto:seal"],
  "permission_levels": [
    {
      "id": "forms.view",
      "label": "Can view",
      "description": "View forms and read the responses they collect."
    },
    {
      "id": "forms.manage",
      "label": "Can manage",
      "description": "Create and edit forms, publish or unpublish them, and manage submissions.",
      "implies": ["forms.view"]
    }
  ],
  "companion": {
    "label": "Forms",
    "icon": "pencil-edit-02"
  },
  "contributes": {
    "sidebar_buttons": [
      {
        "id": "forms-workspace",
        "title": "Forms",
        "icon": "pencil-edit-02",
        "target": "/plugin/app__forms-companion",
        "context": { "view": "forms" },
        "order": 72
      }
    ]
  },
  "sidecars": [
    {
      "name": "forms",
      "process": {
        "kind": "local",
        "command": "ryu-forms",
        "command_env": "RYU_FORMS_BIN",
        "port_env": "RYU_FORMS_PORT"
      },
      "host_api": { "grants": ["crypto:seal"] },
      "port": 8023,
      "health_path": "/health",
      "lazy": true,
      "idle_stop_secs": 900,
      "http": {
        "mount": "/api/forms",
        "public_mount": "/forms",
        "max_body_bytes": 131072,
        "routes": [
          { "path": "/status", "method": "GET", "permission": "forms.view" },
          {
            "path": "/admin/forms",
            "method": "GET",
            "permission": "forms.view"
          },
          {
            "path": "/admin/forms",
            "method": "POST",
            "permission": "forms.manage"
          },
          {
            "path": "/admin/forms/:id",
            "method": "GET",
            "permission": "forms.view"
          },
          {
            "path": "/admin/forms/:id",
            "method": "PUT",
            "permission": "forms.manage"
          },
          {
            "path": "/admin/forms/:id",
            "method": "DELETE",
            "permission": "forms.manage"
          },
          {
            "path": "/admin/forms/:id/publish",
            "method": "POST",
            "permission": "forms.manage"
          },
          {
            "path": "/admin/forms/:id/unpublish",
            "method": "POST",
            "permission": "forms.manage"
          },
          {
            "path": "/admin/forms/:id/responses",
            "method": "GET",
            "permission": "forms.view"
          },
          {
            "path": "/admin/forms/:id/export",
            "method": "GET",
            "permission": "forms.view"
          },
          { "path": "/:slug", "method": "GET", "auth": "public" },
          { "path": "/:slug/submissions", "method": "POST", "auth": "public" }
        ]
      }
    }
  ]
}

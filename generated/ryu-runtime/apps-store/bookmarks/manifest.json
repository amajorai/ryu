{
  "tags": ["bookmarks", "browser", "knowledge", "search"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-bookmarks",
  "homepage": "https://github.com/amajorai/ryu-bookmarks",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/bookmarks",
  "name": "Bookmarks",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Knowledge & Memory",
  "description": "A self-organizing bookmark library with HTML/browser imports, notes, inferred collections, and semantic search through Ryu Spaces.",
  "tagline": "Remember why you saved it",
  "keywords": [
    "bookmarks",
    "browser",
    "reading list",
    "semantic search",
    "knowledge"
  ],
  "icon": "bookmark-02",
  "iconDither": { "from": 214, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "none" },
    "mobile": { "support": "none" },
    "extension": { "support": "full" },
    "web": { "support": "none" },
    "cli": { "support": "none" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "bookmarks-companion",
      "name": "Bookmarks",
      "kind": "companion",
      "config": {
        "label": "Bookmarks",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "requires": {
    "apps": [
      {
        "id": "@ryu/spaces"
      }
    ],
    "grants": ["spaces:docs"]
  },
  "permission_grants": ["spaces:docs", "storage:kv"],
  "permission_levels": [
    {
      "id": "bookmarks.view",
      "label": "Can browse",
      "description": "Read your saved bookmarks and use semantic search across their titles, notes, tags, and URLs."
    },
    {
      "id": "bookmarks.manage",
      "label": "Can manage",
      "description": "Add, import, edit, favorite, and delete bookmarks in the Bookmarks library.",
      "implies": ["bookmarks.view"]
    }
  ],
  "contributes": {
    "sidebar_buttons": [
      {
        "id": "bookmarks-all",
        "title": "All bookmarks",
        "icon": "bookmark-02",
        "target": "/plugin/app__bookmarks-companion",
        "context": { "filter": "all" },
        "order": 80
      },
      {
        "id": "bookmarks-favorites",
        "title": "Favorites",
        "icon": "star-01",
        "target": "/plugin/app__bookmarks-companion",
        "context": { "filter": "favorites" },
        "order": 81
      },
      {
        "id": "bookmarks-recent",
        "title": "Recently saved",
        "icon": "clock-01",
        "target": "/plugin/app__bookmarks-companion",
        "context": { "filter": "recent" },
        "order": 82
      }
    ],
    "context_menu_items": [
      {
        "id": "bookmarks.save-page",
        "label": "Save page to Bookmarks",
        "icon": "bookmark-02",
        "anchor": "browser-page",
        "capability": "browser.savePage",
        "args": { "dispatch": "browser.savePage" },
        "feedback": {
          "loading": "Saving to Bookmarks…",
          "success": "Saved to Bookmarks",
          "error": "Couldn't save this page to Bookmarks"
        },
        "order": 20
      }
    ],
    "chat_widget_templates": [
      {
        "id": "bookmarks.chat",
        "title": "Bookmarks widget",
        "description": "Bookmarks chat widget metadata is coming soon; no render tool is available yet.",
        "triggers": ["bookmarks widget"],
        "examples": ["Show me a bookmarks widget"],
        "backing": {},
        "display_mode": "inline",
        "safe_action_ids": [],
        "availability": "coming-soon"
      }
    ]
  }
}

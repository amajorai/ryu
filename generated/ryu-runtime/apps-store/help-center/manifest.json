{
  "tags": ["support", "tickets", "knowledge", "ai"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-help-center",
  "homepage": "https://github.com/amajorai/ryu-help-center",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/help-center",
  "name": "Help Center",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Communication",
  "description": "A Ryu support workspace for resolving tickets, improving knowledge, and reviewing AI assistance.",
  "tagline": "Resolve support questions with your whole team",
  "keywords": ["support", "tickets", "knowledge", "help center"],
  "icon": "customer-service-01",
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "none" },
    "mobile": { "support": "none" },
    "extension": { "support": "none" },
    "web": { "support": "none" },
    "cli": { "support": "none" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "help-center-companion",
      "name": "Help Center",
      "kind": "companion",
      "config": {
        "label": "Help Center",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "requires": {
    "apps": [{ "id": "@ryu/spaces" }],
    "grants": ["spaces:docs"]
  },
  "permission_grants": ["spaces:docs", "storage:kv", "hook:side-model"],
  "companion": { "label": "Help Center", "icon": "customer-service-01" },
  "contributes": {
    "sidebar_buttons": [
      {
        "id": "help-center-overview",
        "title": "Overview",
        "icon": "dashboard-square-02",
        "target": "/plugin/app__help-center-companion",
        "context": { "view": "overview" },
        "order": 80
      },
      {
        "id": "help-center-inbox",
        "title": "Inbox",
        "icon": "inbox",
        "target": "/plugin/app__help-center-companion",
        "context": { "view": "inbox" },
        "order": 81
      },
      {
        "id": "help-center-tickets",
        "title": "Tickets",
        "icon": "inbox",
        "target": "/plugin/app__help-center-companion",
        "context": { "view": "tickets" },
        "order": 82
      },
      {
        "id": "help-center-knowledge",
        "title": "Knowledge",
        "icon": "book-02",
        "target": "/plugin/app__help-center-companion",
        "context": { "view": "knowledge" },
        "order": 83
      },
      {
        "id": "help-center-agent",
        "title": "Agent",
        "icon": "sparkles",
        "target": "/plugin/app__help-center-companion",
        "context": { "view": "agent" },
        "order": 84
      },
      {
        "id": "help-center-insights",
        "title": "Insights",
        "icon": "activity-03",
        "target": "/plugin/app__help-center-companion",
        "context": { "view": "insights" },
        "order": 85
      }
    ]
  }
}

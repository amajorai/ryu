{
  "tags": ["webhooks", "integrations", "ingress", "automation"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-webhooks",
  "homepage": "https://github.com/amajorai/ryu-webhooks",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/webhooks",
  "name": "Webhooks",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Automation",
  "description": "Inbound webhook endpoint registry: resolved public URLs, signing-secret configuration, last-delivery times, and the ingress backend status.",
  "tagline": "See every inbound webhook this node answers",
  "keywords": ["webhooks", "integrations", "ingress", "automation"],
  "icon": "webhook",
  "iconDither": { "from": 260, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "webhooks-companion",
      "name": "Webhooks",
      "kind": "companion",
      "config": {
        "label": "Webhooks",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": ["webhooks:crud", "ui:toast"],
  "permission_levels": [
    {
      "id": "webhooks.view",
      "label": "Can view",
      "description": "See registered inbound endpoints, their public URLs, signing-secret status, and when each last received a delivery."
    },
    {
      "id": "webhooks.manage",
      "label": "Can manage",
      "description": "Configure and rotate inbound signing secrets, which decides which outside systems may trigger work here.",
      "implies": ["webhooks.view"]
    }
  ],
  "companion": {
    "label": "Webhooks",
    "icon": "webhook"
  },
  "contributes": {
    "chat_widget_templates": [
      {
        "id": "webhooks.chat",
        "title": "Webhooks widget",
        "description": "Webhooks chat widget metadata is coming soon; no render tool is available yet.",
        "triggers": ["webhooks widget"],
        "examples": ["Show me a webhooks widget"],
        "backing": {},
        "display_mode": "inline",
        "safe_action_ids": [],
        "availability": "coming-soon"
      }
    ]
  }
}

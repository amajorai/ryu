{
  "tags": ["tasks", "todos", "productivity", "tracking"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-quests",
  "homepage": "https://github.com/amajorai/ryu-quests",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/quests",
  "name": "Quests",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Productivity",
  "description": "Quests: auto-detecting todos surfaced from your chats and activity, tracked as a lightweight quest board with progress and completion.",
  "tagline": "Your todos, found for you",
  "keywords": ["tasks", "todos", "productivity", "tracking"],
  "icon": "target-02",
  "iconDither": { "from": 294, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "quests-companion",
      "name": "Quests",
      "kind": "companion",
      "config": {
        "label": "Quests",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "sidecars": [
    {
      "name": "ryu-quests",
      "process": {
        "kind": "local",
        "command": "ryu-quests",
        "command_env": "RYU_QUESTS_BIN",
        "port_env": "RYU_QUESTS_PORT"
      },
      "port": 7991,
      "health_path": "/health",
      "http": {
        "mount": "/api/quests",
        "public_mount": "/api/quests",
        "routes": [
          { "path": "/events", "permission": "quests.view" },
          {
            "path": "/detection-config",
            "method": "GET",
            "permission": "quests.view"
          },
          {
            "path": "/detection-config",
            "method": "PUT",
            "permission": "quests.edit"
          },
          {
            "path": "/capture",
            "method": "POST",
            "permission": "quests.capture"
          },
          {
            "path": "/scratchpad",
            "method": "GET",
            "permission": "quests.view"
          },
          {
            "path": "/scratchpad",
            "method": "PUT",
            "permission": "quests.edit"
          },
          { "path": "/", "method": "GET", "permission": "quests.view" },
          { "path": "/", "method": "POST", "permission": "quests.edit" },
          { "path": "/:id", "method": "GET", "permission": "quests.view" },
          { "path": "/:id", "method": "PUT", "permission": "quests.edit" },
          { "path": "/:id", "method": "DELETE", "permission": "quests.edit" },
          { "path": "/:id/use", "permission": "quests.edit" },
          { "path": "/:id/pin", "permission": "quests.edit" },
          { "path": "/:id/judge", "permission": "quests.edit" },
          { "path": "/:id/complete", "permission": "quests.edit" },
          { "path": "/:id/dismiss", "permission": "quests.edit" },
          { "path": "/:id/reopen", "permission": "quests.edit" },
          { "path": "/:id/suggestion/accept", "permission": "quests.edit" },
          { "path": "/:id/suggestion/dismiss", "permission": "quests.edit" }
        ]
      }
    }
  ],
  "permission_grants": [
    "quests:crud",
    "quests:capture",
    "ui:toast",
    "ui:declarative-http"
  ],
  "permission_levels": [
    {
      "id": "quests.view",
      "label": "Can view",
      "description": "See the quest board and the todos detected from chats and activity."
    },
    {
      "id": "quests.edit",
      "label": "Can edit",
      "description": "Create, complete, and delete quests.",
      "implies": ["quests.view"]
    },
    {
      "id": "quests.capture",
      "label": "Can capture",
      "description": "Keep selected text, links, and prompts from other apps onto the board, along with the app and page they came from. This is a wider reach than editing the board — it stores content the user selected elsewhere, and the `quests.capture` bridge verb is gated by its own `quests:capture` grant.",
      "implies": ["quests.edit"]
    }
  ],
  "companion": {
    "label": "Quests",
    "icon": "target-02"
  },
  "contributes": {
    "chat_widget_templates": [
      {
        "id": "quests.chat",
        "title": "Quests widget",
        "description": "Open Quests data in a host-rendered chat widget.",
        "triggers": ["quests widget"],
        "examples": ["Show me a quests widget"],
        "backing": { "view_id": "quest-board" },
        "display_mode": "inline",
        "safe_action_ids": [],
        "availability": "available"
      }
    ],
    "hook_events": [
      {
        "id": "@ryu/quests#quest.created",
        "title": "Quest created",
        "description": "A new quest was added to the board, from the companion UI or the API. Fires as soon as the quest is persisted, exactly once per quest — reopening a finished quest does not re-fire it.",
        "payload_example": {
          "id": "quest_9f3c1b2a4d5e6f708192a3b4c5d6e7f8",
          "title": "Ship the release notes",
          "detail": "Cover the routing rewrite",
          "completion_condition": "the release notes are published",
          "created_at": "2026-08-01T09:12:44Z"
        }
      },
      {
        "id": "@ryu/quests#quest.captured",
        "title": "Item captured",
        "description": "Something was kept from the capture gesture or the API — a selection, a link, a prompt to run next, a note. `kind` is what it was filed as; `source` is where it came from and is absent when the item was typed straight in. A captured task fires this AND `quest.created`.",
        "payload_example": {
          "id": "quest_1a2b3c4d5e6f708192a3b4c5d6e7f809",
          "kind": "note",
          "title": "The retry budget is per-attempt, not per-call",
          "body": "The retry budget is per-attempt, not per-call — so a 3x retry on a 4-call fan-out is 12 attempts.",
          "source": {
            "app": "Claude",
            "title": "Retry budgets",
            "url": "https://claude.ai/chat/abc"
          },
          "created_at": "2026-08-01T09:12:44Z"
        }
      },
      {
        "id": "@ryu/quests#quest.suggested",
        "title": "Quest completion suggested",
        "description": "The judge decided a quest looks done but not confidently enough to close it, so it is waiting on the user to confirm. Fires only on a NEW suggestion — an unchanged verdict on a later detection pass does not re-fire.",
        "payload_example": {
          "id": "quest_9f3c1b2a4d5e6f708192a3b4c5d6e7f8",
          "title": "Ship the release notes",
          "confidence": 72,
          "reason": "The release notes page was published a few minutes ago.",
          "suggested_at": "2026-08-01T10:31:08Z"
        }
      },
      {
        "id": "@ryu/quests#quest.completed",
        "title": "Quest completed",
        "description": "A quest moved to done. `source` is how it was decided (`manual` = the user checked it off, `detected` = the judge did) and `auto` is whether the engine closed it without the user — accepting a suggestion is `detected` but not `auto`. Can fire more than once for the same quest, because a finished quest can be reopened and finished again.",
        "payload_example": {
          "id": "quest_9f3c1b2a4d5e6f708192a3b4c5d6e7f8",
          "title": "Ship the release notes",
          "source": "detected",
          "auto": true,
          "confidence": 91,
          "completed_at": "2026-08-01T10:33:20Z"
        }
      }
    ],
    "settings_tabs": [
      {
        "id": "quests.settings",
        "title": "Tasks",
        "scope": "node",
        "view": "quests"
      }
    ],
    "views": [
      {
        "id": "quest-board",
        "title": "Quest Board",
        "view": "list-detail",
        "spec": {
          "view": "list-detail",
          "items": [],
          "emptyText": "No quests yet.",
          "source": {
            "//": "?kind=task ONLY. Captures (notes/links/prompts/clips) are open forever and have no completion condition, so a plain /api/quests here would list them as todos and offer them a Complete action.",
            "http": { "method": "GET", "path": "/api/quests?kind=task" },
            "items": "quests",
            "map": {
              "subtitle": "detail",
              "accessory": "status"
            }
          },
          "itemActions": [
            {
              "id": "complete",
              "label": "Complete",
              "style": "primary",
              "confirm": "Mark this quest as complete?",
              "http": {
                "method": "POST",
                "path": "/api/quests/{{item.id}}/complete"
              }
            }
          ]
        }
      }
    ]
  }
}

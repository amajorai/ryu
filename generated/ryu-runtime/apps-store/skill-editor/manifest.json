{
  "tags": ["skills", "authoring", "editor", "developer"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-skill-editor",
  "homepage": "https://github.com/amajorai/ryu-skill-editor",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/skill-editor",
  "name": "Skill Editor",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Developer Tools",
  "description": "Author a user-owned Agent Skill (SKILL.md): front-matter fields (name / description / allowed tools / always-on), a markdown body editor, debounced autosave, and server-backed undoable version history.",
  "tagline": "Write and version your own agent skills",
  "keywords": ["skills", "authoring", "editor", "developer"],
  "icon": "sparkles",
  "iconDither": { "from": 308, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "skill-editor-companion",
      "name": "Skill Editor",
      "kind": "companion",
      "config": {
        "label": "Skill Editor",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": ["skills:crud", "shell:integrate", "ui:toast"],
  "permission_levels": [
    {
      "id": "skill-editor.edit",
      "label": "Can edit skills",
      "description": "Create and rewrite a skill's SKILL.md — its instructions, allowed tools, and always-on flag — which changes what every agent loading that skill does."
    }
  ],
  "companion": {
    "label": "Skill Editor",
    "icon": "sparkles"
  },
  "contributes": {
    "chat_widget_templates": [
      {
        "id": "skill-editor.chat",
        "title": "Skill Editor widget",
        "description": "Skill Editor chat widget metadata is coming soon; no render tool is available yet.",
        "triggers": ["skill editor widget"],
        "examples": ["Show me a skill editor widget"],
        "backing": {},
        "display_mode": "inline",
        "safe_action_ids": [],
        "availability": "coming-soon"
      }
    ]
  }
}

{
  "id": "@ryu/backstage",
  "name": "Backstage",
  "version": "1.5.3",
  "stability": "experimental",
  "category": "Creative",
  "description": "A local-first YouTube thumbnail studio that keeps its editor while using Ryu for governed model and image generation.",
  "tagline": "Make thumbnails with your own creative workspace and Ryu AI",
  "keywords": [
    "youtube",
    "thumbnails",
    "creative",
    "design",
    "images",
    "editor"
  ],
  "author": { "name": "A Major", "url": "https://amajorai.com" },
  "repository": "https://github.com/amajorai/backstage",
  "homepage": "https://github.com/amajorai/backstage",
  "source": "amajorai/backstage",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "icon": "ai-image",
  "iconDither": { "from": 225, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "none" },
    "extension": { "support": "none" },
    "web": { "support": "limited" },
    "cli": { "support": "none" }
  },
  "engines": { "ryu": ">=0.2.0" },
  "runnables": [
    {
      "id": "backstage-companion",
      "name": "Backstage",
      "kind": "companion",
      "config": {
        "label": "Backstage",
        "ui_entry": "./apps/desktop/dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": [
    "storage:kv",
    "media:generate",
    "hook:side-model",
    "hook:run-agent"
  ],
  "permission_levels": [
    {
      "id": "backstage.view",
      "label": "Can view",
      "description": "Browse Backstage projects and open the thumbnail editor."
    },
    {
      "id": "backstage.edit",
      "label": "Can edit",
      "description": "Create projects and change thumbnail layers.",
      "implies": ["backstage.view"]
    },
    {
      "id": "backstage.generate",
      "label": "Can generate",
      "description": "Use Ryu's configured local, managed, or BYOK model and image lanes.",
      "implies": ["backstage.edit"]
    }
  ],
  "companion": { "label": "Backstage", "icon": "ai-image" }
}

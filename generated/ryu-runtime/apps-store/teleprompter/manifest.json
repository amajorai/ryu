{
  "id": "@ryu/teleprompter",
  "name": "Teleprompter",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Media & Voice",
  "description": "A voice-following teleprompter that scrolls your script as you speak, using Ryu's own speech-to-text models instead of a browser or cloud recognizer.",
  "tagline": "Your script follows your voice",
  "author": {
    "name": "Ryu",
    "url": "https://ryuhq.com"
  },
  "repository": "https://github.com/amajorai/ryu-teleprompter",
  "homepage": "https://github.com/amajorai/ryu-teleprompter",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "icon": "book-open-01",
  "iconDither": { "from": 90, "to": "transparent", "direction": "down" },
  "tags": ["teleprompter", "speech", "transcription", "presenting", "video"],
  "keywords": [
    "teleprompter",
    "prompter",
    "script",
    "voice following",
    "autocue"
  ],
  "engines": {
    "ryu": ">=0.3.1"
  },
  "surfaces": {
    "gateway": {
      "support": "none"
    },
    "core": {
      "support": "none"
    },
    "desktop": {
      "support": "full"
    },
    "island": {
      "support": "full"
    },
    "mobile": {
      "support": "none"
    },
    "extension": {
      "support": "none"
    },
    "web": {
      "support": "none"
    },
    "cli": {
      "support": "none"
    }
  },
  "runnables": [
    {
      "id": "teleprompter-companion",
      "name": "Teleprompter",
      "kind": "companion",
      "config": {
        "label": "Teleprompter",
        "ui_entry": "./ui/dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": ["storage:kv", "media:record", "media:transcribe"],
  "permission_levels": [
    {
      "id": "teleprompter.prompt",
      "label": "Can follow your voice",
      "description": "Record short microphone windows while the prompter is running, transcribe them with Ryu's speech-to-text engine, and keep saved scripts in this app's private storage."
    }
  ],
  "companion": {
    "label": "Teleprompter",
    "icon": "book-open-01"
  }
}

{
  "tags": ["invoices", "billing", "cashflow", "finance", "accounts-receivable"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-invoices",
  "homepage": "https://github.com/amajorai/ryu-invoices",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/invoices",
  "name": "Invoices",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Productivity",
  "description": "A local invoice register for tracking what was issued, what is overdue, and what has been paid. Invoices records status and cashflow without replacing a payment processor or accounting system.",
  "tagline": "Know what is due",
  "keywords": [
    "invoices",
    "billing",
    "cashflow",
    "finance",
    "accounts-receivable"
  ],
  "icon": "invoice-03",
  "iconDither": { "from": 210, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "invoices-companion",
      "name": "Invoices",
      "kind": "companion",
      "config": {
        "label": "Invoices",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": ["storage:kv", "shell:integrate", "ui:toast"],
  "permission_levels": [
    {
      "id": "invoices.view",
      "label": "Can view",
      "description": "See invoice status, due dates, and local cashflow totals."
    },
    {
      "id": "invoices.edit",
      "label": "Can edit",
      "description": "Create invoices and update their local status.",
      "implies": ["invoices.view"]
    }
  ],
  "companion": { "label": "Invoices", "icon": "invoice-03" }
}

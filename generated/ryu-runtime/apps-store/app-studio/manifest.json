{
  "tags": ["apps", "builder", "no-code", "visual editor", "developer"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-app-studio",
  "homepage": "https://github.com/amajorai/ryu-app-studio",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/app-studio",
  "name": "App Studio",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Developer Tools",
  "description": "Build your own Ryu apps with a drag-and-drop visual editor and chat edits, choose the permissions they may ask for, preview them, and install them into Ryu.",
  "tagline": "Drag and drop your own Ryu apps",
  "keywords": [
    "app builder",
    "drag and drop",
    "visual editor",
    "no-code",
    "companion",
    "apps"
  ],
  "icon": "shapes",
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "none" },
    "mobile": { "support": "none" },
    "extension": { "support": "none" },
    "web": { "support": "none" },
    "cli": { "support": "none" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "app-studio-companion",
      "name": "App Studio",
      "kind": "companion",
      "config": {
        "label": "App Studio",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": [
    "storage:kv",
    "hook:side-model",
    "ui:toast",
    "plugins:install"
  ],
  "permission_levels": [
    {
      "id": "app-studio.build",
      "label": "Can build apps",
      "description": "Create, edit, and delete App Studio drafts."
    },
    {
      "id": "app-studio.install",
      "label": "Can install apps",
      "description": "Install or update the companion-only apps built in App Studio. Installed apps stay disabled until enabled, when their permissions are reviewed.",
      "implies": ["app-studio.build"]
    }
  ],
  "companion": { "label": "App Studio", "icon": "shapes" }
}

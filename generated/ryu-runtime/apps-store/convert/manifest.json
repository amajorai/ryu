{
  "tags": [
    "convert",
    "converter",
    "files",
    "images",
    "documents",
    "pdf",
    "media",
    "local"
  ],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-convert",
  "homepage": "https://github.com/amajorai/ryu-convert",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/convert",
  "name": "Convert",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Documents",
  "description": "A local-only conversion studio for image output and editing, PDF organization and page rendering, text and structured data, readable DOCX input, ZIP manifest inspection and batch bundles, and Mediabunny browser media conversion. It covers resize, crop, rotate, watermark, split, extract, page numbers, compression, PDF-to-image pages, and MP4/MOV/MKV/WebM/WAV/MP3/Ogg/FLAC/AAC/M4A output without an upload service, Docker dependency, or required sidecar; engine-dependent formats stay input-only.",
  "tagline": "Convert files privately on your device",
  "keywords": [
    "convert",
    "converter",
    "file conversion",
    "image",
    "pdf",
    "documents",
    "media",
    "local"
  ],
  "icon": "file-export",
  "iconDither": { "from": 204, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "convert-companion",
      "name": "Convert",
      "kind": "companion",
      "config": {
        "label": "Convert",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": ["storage:kv", "ui:toast", "files:download"],
  "permission_levels": [
    {
      "id": "convert.view",
      "label": "Can view",
      "description": "Open Convert and inspect the local format catalog and recent conversion history."
    },
    {
      "id": "convert.edit",
      "label": "Can convert",
      "description": "Read selected files locally, create converted copies, and download them back to this device.",
      "implies": ["convert.view"]
    }
  ],
  "companion": { "label": "Convert", "icon": "file-export" },
  "contributes": {
    "sidebar_buttons": [
      {
        "id": "convert-new",
        "title": "Convert",
        "icon": "file-export",
        "target": "/plugin/app__convert-companion",
        "context": { "view": "convert" },
        "order": 58
      },
      {
        "id": "convert-history",
        "title": "History",
        "icon": "clock-01",
        "target": "/plugin/app__convert-companion",
        "context": { "view": "history" },
        "order": 59
      },
      {
        "id": "convert-formats",
        "title": "Formats",
        "icon": "package-open",
        "target": "/plugin/app__convert-companion",
        "context": { "view": "formats" },
        "order": 60
      },
      {
        "id": "convert-tools",
        "title": "Tools",
        "icon": "settings-01",
        "target": "/plugin/app__convert-companion",
        "context": { "view": "tools" },
        "order": 61
      }
    ]
  }
}

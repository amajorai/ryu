{
  "tags": ["ios", "android", "simulator", "emulator", "mobile"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-simulator",
  "homepage": "https://github.com/amajorai/ryu-simulator",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/simulator",
  "name": "Simulators",
  "version": "0.1.14",
  "stability": "experimental",
  "description": "Drive iOS Simulators (macOS + Xcode) and Android Emulators from a workspace tab. Ryu runs the device-control toolchain (`simctl`, `adb`) as a local sidecar and exposes the grant-gated `simulator.control` capability: list/boot devices, install & launch apps, open deep links, screenshot, and (Android) tap/swipe/type. The desktop Simulator panel shows whichever platform the connected node supports.",
  "keywords": ["ios", "android", "simulator", "emulator", "mobile"],
  "icon": "smart-phone-01",
  "iconDither": { "from": 11, "to": "transparent", "direction": "down" },
  "tagline": "iOS Simulator & Android Emulator control for agents",
  "category": "Developer Tools",
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [],
  "sidecars": [
    {
      "name": "simulator",
      "process": {
        "kind": "local",
        "command": "ryu-simulator",
        "command_env": "RYU_SIMULATOR_BIN",
        "port_env": "RYU_SIMULATOR_PORT"
      },
      "port": 7994,
      "health_path": "/health",
      "lazy": true,
      "idle_stop_secs": 300,
      "http": {
        "public_mount": "/api/simulator",
        "routes": [
          { "path": "/", "permission": "simulator.control" },
          { "path": "/health" },
          { "path": "/capabilities", "permission": "simulator.view" },
          { "path": "/devices", "permission": "simulator.view" },
          { "path": "/devices/:id/boot", "permission": "simulator.control" },
          {
            "path": "/devices/:id/shutdown",
            "permission": "simulator.control"
          },
          { "path": "/devices/:id/install", "permission": "simulator.control" },
          { "path": "/devices/:id/launch", "permission": "simulator.control" },
          { "path": "/devices/:id/openurl", "permission": "simulator.control" },
          {
            "path": "/devices/:id/screenshot",
            "permission": "simulator.control"
          },
          { "path": "/devices/:id/tap", "permission": "simulator.control" },
          { "path": "/devices/:id/swipe", "permission": "simulator.control" },
          { "path": "/devices/:id/text", "permission": "simulator.control" },
          { "path": "/devices/:id/key", "permission": "simulator.control" }
        ]
      }
    }
  ],
  "provides": [
    {
      "capability": "simulator.control",
      "version": "1.0.0",
      "sidecar": "simulator",
      "route": "/",
      "grant": "simulator:control"
    }
  ],
  "permission_grants": ["simulator:control"],
  "permission_levels": [
    {
      "id": "simulator.view",
      "label": "Can view",
      "description": "List the iOS Simulators and Android Emulators on this node and screenshot them."
    },
    {
      "id": "simulator.control",
      "label": "Can control",
      "description": "Boot devices, install and launch apps, open deep links, and send taps, swipes, and typing to them.",
      "implies": ["simulator.view"]
    }
  ],
  "contributes": {
    "chat_widget_templates": [
      {
        "id": "simulator.chat",
        "title": "Simulators widget",
        "description": "Simulators chat widget metadata is coming soon; no render tool is available yet.",
        "triggers": ["simulators widget"],
        "examples": ["Show me a simulators widget"],
        "backing": {},
        "display_mode": "inline",
        "safe_action_ids": [],
        "availability": "coming-soon"
      }
    ],
    "dock_panels": [
      {
        "id": "simulator",
        "title": "Simulator",
        "icon": "hugeicons:smart-phone-01",
        "placement": "both",
        "panel": "native"
      }
    ]
  }
}

{
  "tags": ["sites", "publishing", "hosting", "domains", "public edge"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-sites",
  "homepage": "https://github.com/amajorai/ryu-sites",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/sites",
  "name": "Sites",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Developer Tools",
  "description": "A local-first Sites control surface for previewing projects, public-edge routes, domains, quotas, and Help Center widgets.",
  "tagline": "Make every public route explainable",
  "keywords": [
    "sites",
    "publishing",
    "hosting",
    "domains",
    "public edge",
    "widgets"
  ],
  "icon": "browser",
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "none" },
    "mobile": { "support": "none" },
    "extension": { "support": "none" },
    "web": { "support": "none" },
    "cli": { "support": "none" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "sites-companion",
      "name": "Sites",
      "kind": "companion",
      "config": {
        "label": "Sites",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": [],
  "companion": { "label": "Sites", "icon": "browser" },
  "contributes": {
    "sidebar_buttons": [
      {
        "id": "sites-overview",
        "title": "Overview",
        "icon": "dashboard-square-02",
        "target": "/plugin/app__sites-companion",
        "context": { "view": "overview" },
        "order": 70
      },
      {
        "id": "sites-projects",
        "title": "Projects",
        "icon": "activity-03",
        "target": "/plugin/app__sites-companion",
        "context": { "view": "projects" },
        "order": 71
      },
      {
        "id": "sites-edge",
        "title": "Public edge",
        "icon": "link-01",
        "target": "/plugin/app__sites-companion",
        "context": { "view": "edge" },
        "order": 72
      },
      {
        "id": "sites-widget",
        "title": "Widget",
        "icon": "sparkles",
        "target": "/plugin/app__sites-companion",
        "context": { "view": "widget" },
        "order": 73
      }
    ]
  }
}

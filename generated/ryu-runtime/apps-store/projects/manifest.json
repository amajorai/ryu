{
  "tags": ["projects", "tasks", "planning", "delivery", "operations"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-projects",
  "homepage": "https://github.com/amajorai/ryu-projects",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/projects",
  "name": "Projects",
  "version": "0.2.0",
  "stability": "experimental",
  "category": "Productivity",
  "description": "Projects are where long-running work lives: each project has a coordinator main thread, the bots and Groups working on it (each with its own main thread), shared context, model defaults, and the sessions they spawn.",
  "tagline": "Keep the work moving",
  "keywords": ["projects", "tasks", "planning", "delivery", "operations"],
  "icon": "task-01",
  "iconDither": { "from": 210, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "projects-companion",
      "name": "Projects",
      "kind": "companion",
      "config": {
        "label": "Projects",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    },
    {
      "id": "projects-run",
      "name": "Run Projects coordinator",
      "kind": "tool",
      "config": {
        "slug": "projects.run",
        "backend": "http",
        "method": "POST",
        "url": "core:/api/ext/@ryu/projects/tools/run",
        "secret_headers": { "Authorization": "Bearer env:RYU_TOKEN" },
        "fail_open": true,
        "unwrap_body": true,
        "description": "Dispatch one request to a durable Projects coordinator.",
        "input_schema": {
          "type": "object",
          "required": ["projectId", "prompt"],
          "properties": {
            "projectId": { "type": "string" },
            "prompt": { "type": "string" }
          }
        }
      }
    }
  ],
  "permission_grants": [
    "app:http",
    "tool:http-egress:127.0.0.1",
    "chat.sendFollowUp",
    "chat:project-guidance",
    "crypto:seal",
    "shell:integrate",
    "spaces:docs",
    "storage:kv",
    "ui:toast"
  ],
  "sidecars": [
    {
      "name": "projects",
      "process": {
        "kind": "local",
        "command": "ryu-projects",
        "command_env": "RYU_PROJECTS_BIN",
        "port_env": "RYU_PROJECTS_PORT"
      },
      "port": 8022,
      "health_path": "/health",
      "lazy": false,
      "http": {
        "mount": "/api/projects",
        "public_mount": "/api/projects",
        "max_body_bytes": 524288,
        "routes": [
          {
            "path": "/bootstrap",
            "method": "GET",
            "permission": "projects.view"
          },
          {
            "path": "/tools/run",
            "method": "POST",
            "permission": "projects.edit"
          },
          {
            "path": "/projects",
            "method": "GET",
            "permission": "projects.view"
          },
          {
            "path": "/projects",
            "method": "POST",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/import",
            "method": "POST",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id",
            "method": "GET",
            "permission": "projects.view"
          },
          {
            "path": "/projects/:id",
            "method": "PATCH",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id",
            "method": "DELETE",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id/run",
            "method": "POST",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id/main-thread",
            "method": "POST",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id/members",
            "method": "POST",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id/members/:kind/:member_id",
            "method": "DELETE",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id/defaults",
            "method": "PUT",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id/guidance",
            "method": "PUT",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id/members/agent/:member_id/goal",
            "method": "PUT",
            "permission": "projects.edit"
          },
          {
            "path": "/sidebar",
            "method": "GET",
            "permission": "projects.view"
          },
          {
            "path": "/projects/:id/context",
            "method": "GET",
            "permission": "projects.view"
          },
          {
            "path": "/projects/:id/context",
            "method": "POST",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id/context/:context_id",
            "method": "PATCH",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id/context/:context_id",
            "method": "DELETE",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id/workers",
            "method": "GET",
            "permission": "projects.view"
          },
          {
            "path": "/projects/:id/workers",
            "method": "POST",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id/subscriptions",
            "method": "GET",
            "permission": "projects.view"
          },
          {
            "path": "/projects/:id/subscriptions",
            "method": "POST",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id/subscriptions/:subscription_id",
            "method": "PATCH",
            "permission": "projects.edit"
          },
          {
            "path": "/projects/:id/subscriptions/:subscription_id",
            "method": "DELETE",
            "permission": "projects.edit"
          },
          {
            "path": "/events/:source",
            "method": "POST",
            "permission": "projects.edit"
          }
        ]
      },
      "host_api": {
        "grants": ["chat.sendFollowUp", "chat:project-guidance", "crypto:seal"]
      }
    }
  ],
  "permission_levels": [
    {
      "id": "projects.view",
      "label": "Can view",
      "description": "See projects, owners, due dates, and task progress."
    },
    {
      "id": "projects.edit",
      "label": "Can edit",
      "description": "Create projects, add tasks, update delivery status, dispatch coordinator work, and manage subscriptions.",
      "implies": ["projects.view"]
    }
  ],
  "contributes": {
    "sidebar_sections": [
      {
        "id": "projects",
        "title": "Projects",
        "icon": "task-01",
        "order": 5,
        "spec": {
          "rowStyle": "messaging",
          "source": {
            "http": { "method": "GET", "path": "/api/projects/sidebar" },
            "items": "projects",
            "limit": 50,
            "refreshMs": 60000,
            "map": {
              "id": "id",
              "title": "name",
              "titleFallback": "Project",
              "subtitle": "summary",
              "accessory": "updatedAt",
              "avatar": "icon"
            }
          },
          "dateKey": "updatedAt",
          "itemTarget": "/chat?conversationId={{item.mainThreadId}}"
        }
      }
    ]
  },
  "companion": { "label": "Projects", "icon": "task-01" }
}

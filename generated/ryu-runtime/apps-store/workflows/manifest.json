{
  "tags": ["workflows", "automation", "dag", "triggers"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-workflows",
  "homepage": "https://github.com/amajorai/ryu-workflows",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/workflows",
  "name": "Workflows",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Automation",
  "description": "Workflows: petgraph DAG automation with triggers, durable execution, and a natural-language workflow builder.",
  "tagline": "Automate anything as a durable DAG",
  "keywords": ["workflows", "automation", "dag", "triggers"],
  "icon": "workflow-circle-06",
  "iconDither": {
    "from": 299,
    "to": "transparent",
    "direction": "down"
  },
  "surfaces": {
    "gateway": {
      "support": "none"
    },
    "core": {
      "support": "full"
    },
    "desktop": {
      "support": "full"
    },
    "island": {
      "support": "limited"
    },
    "mobile": {
      "support": "limited"
    },
    "extension": {
      "support": "none"
    },
    "web": {
      "support": "full"
    },
    "cli": {
      "support": "list"
    }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "workflows-companion",
      "name": "Workflows",
      "kind": "companion",
      "config": {
        "label": "Workflows",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": [
    "workflows:crud",
    "workflows:runstate",
    "workflows:catalogs",
    "ghost:record",
    "core:list_agents",
    "app:realtime",
    "ui:toast",
    "ui:declarative-http"
  ],
  "permission_levels": [
    {
      "id": "workflow.view",
      "label": "Can view",
      "description": "See workflows and their run history, without changing or starting anything."
    },
    {
      "id": "workflow.run",
      "label": "Can run",
      "description": "Start a workflow and watch it execute. Implies viewing.",
      "implies": ["workflow.view"]
    },
    {
      "id": "workflow.edit",
      "label": "Can edit",
      "description": "Create and change workflows, including their triggers and steps. Implies running.",
      "implies": ["workflow.run"]
    },
    {
      "id": "workflow.delete",
      "label": "Can delete",
      "description": "Permanently remove a workflow and its run history. Implies editing.",
      "implies": ["workflow.edit"]
    }
  ],
  "companion": {
    "label": "Workflows",
    "icon": "workflow-circle-06"
  },
  "contributes": {
    "chat_widget_templates": [
      {
        "id": "workflows.chat",
        "title": "Workflows widget",
        "description": "Workflows chat widget metadata is coming soon; no render tool is available yet.",
        "triggers": ["workflows widget"],
        "examples": ["Show me a workflows widget"],
        "backing": {},
        "display_mode": "inline",
        "safe_action_ids": [],
        "availability": "coming-soon"
      }
    ],
    "create_actions": [
      {
        "id": "workflows.new",
        "label": "New workflow",
        "icon": "workflow-circle-06",
        "target": "/workflows/new",
        "title": "New workflow",
        "order": 60
      }
    ],
    "sidebar_sections": [
      {
        "id": "workflows",
        "title": "Workflows",
        "icon": "workflow-circle-06",
        "order": 60,
        "spec": {
          "source": {
            "http": { "method": "GET", "path": "/workflows" },
            "items": "workflows",
            "map": {
              "id": "id",
              "title": "name",
              "titleFallback": "Untitled workflow",
              "subtitle": "description",
              "accessory": "updatedAt"
            },
            "refreshMs": 15000
          },
          "dateKey": "updated_at",
          "itemTarget": "/workflows/{{item.id}}",
          "create": {
            "label": "New workflow",
            "target": "/workflows/new"
          },
          "entity": {
            "anchor": "workflow",
            "idKey": "workflow_id"
          },
          "emptyState": {
            "title": "No workflows yet",
            "description": "Create a workflow to automate a durable sequence of steps.",
            "unavailable": "Workflows are unavailable on this node."
          }
        }
      }
    ],
    "store_tabs": [
      {
        "id": "workflows",
        "title": "Workflows",
        "subtitle": "Ready-made automation templates built on proven agent patterns.",
        "icon": "workflow-circle-06",
        "group": "catalog",
        "order": 60,
        "spec": {
          "source": {
            "http": { "method": "GET", "path": "/api/workflows/catalog" },
            "items": "templates"
          },
          "map": {
            "id": "id",
            "title": "name",
            "description": "description",
            "badge": "pattern",
            "badgeTransform": "humanize",
            "tags": "tags",
            "sourceUrl": "source_url"
          },
          "detail": {
            "item": "template",
            "source": {
              "http": {
                "method": "GET",
                "path": "/api/workflows/catalog/{{item.id}}"
              }
            },
            "graph": {
              "title": "Workflow",
              "nodes": "nodes",
              "edges": "edges",
              "nodeId": "id",
              "edgeSource": "from",
              "edgeTarget": "to",
              "edgeLabel": "branch"
            }
          },
          "groupBy": "category",
          "groups": [
            { "value": "research", "label": "Research" },
            { "value": "orchestration", "label": "Orchestration" },
            { "value": "quality", "label": "Quality" },
            { "value": "automation", "label": "Automation" }
          ],
          "searchFields": ["pattern"],
          "searchPlaceholder": "Search workflow templates…",
          "install": {
            "http": {
              "method": "POST",
              "path": "/api/workflows/catalog/install",
              "body": { "template_id": "{{item.id}}" }
            },
            "label": "Install",
            "successMessage": "Workflow created",
            "targetFrom": "workflow_id",
            "openTarget": "/workflows/{{result.id}}"
          },
          "empty": {
            "title": "No templates found",
            "description": "Try a different search."
          }
        }
      }
    ]
  }
}

{
  "tags": ["people", "hr", "onboarding", "directory", "operations"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-people",
  "homepage": "https://github.com/amajorai/ryu-people",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/people",
  "name": "People",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Productivity",
  "description": "A private local people directory for team roles, onboarding, and leave status. People keeps internal operations on the node and does not replace payroll, recruiting, or an HRIS.",
  "tagline": "Keep the team in view",
  "keywords": ["people", "hr", "onboarding", "directory", "operations"],
  "icon": "user-group-03",
  "iconDither": { "from": 210, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "people-companion",
      "name": "People",
      "kind": "companion",
      "config": {
        "label": "People",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": ["storage:kv", "shell:integrate", "ui:toast"],
  "permission_levels": [
    {
      "id": "people.view",
      "label": "Can view",
      "description": "See the local team directory, roles, and onboarding progress."
    },
    {
      "id": "people.edit",
      "label": "Can edit",
      "description": "Add people and update local team and onboarding records.",
      "implies": ["people.view"]
    }
  ],
  "companion": { "label": "People", "icon": "user-group-03" }
}

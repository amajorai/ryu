{
  "tags": ["activity", "feed", "notifications", "history"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-activity",
  "homepage": "https://github.com/amajorai/ryu-activity",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/activity",
  "name": "Activity",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Productivity",
  "description": "The unified activity feed: everything happening on this node — monitor alerts, finished tasks, runs, approvals, meetings, and notes — newest first, grouped by day.",
  "tagline": "Everything happening on this node, newest first",
  "keywords": ["activity", "feed", "notifications", "history"],
  "icon": "activity-03",
  "iconDither": { "from": 210, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "activity-companion",
      "name": "Activity",
      "kind": "companion",
      "config": {
        "label": "Activity",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": ["activity:read", "shell:integrate"],
  "permission_levels": [
    {
      "id": "activity.view",
      "label": "Can view",
      "description": "See the node's activity feed: every monitor alert, finished run, approval, meeting, and note."
    }
  ],
  "companion": {
    "label": "Activity",
    "icon": "activity-03"
  },
  "contributes": {
    "chat_widget_templates": [
      {
        "id": "activity.chat",
        "title": "Activity widget",
        "description": "Activity chat widget metadata is coming soon; no render tool is available yet.",
        "triggers": ["activity widget"],
        "examples": ["Show me a activity widget"],
        "backing": {},
        "display_mode": "inline",
        "safe_action_ids": [],
        "availability": "coming-soon"
      }
    ]
  }
}

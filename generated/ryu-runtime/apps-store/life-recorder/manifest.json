{
  "id": "@ryu/life-recorder",
  "name": "Life Recorder",
  "version": "0.3.1",
  "stability": "experimental",
  "category": "Knowledge & Memory",
  "description": "Recall recent speech with Shadow, transcribe recordings, and keep private conversation recaps and searchable moments.",
  "tagline": "Stay in the conversation",
  "author": {
    "name": "Ryu",
    "url": "https://ryuhq.com"
  },
  "repository": "https://github.com/amajorai/ryu-life-recorder",
  "homepage": "https://github.com/amajorai/ryu-life-recorder",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "icon": "mic-01",
  "iconDither": { "from": 318, "to": "transparent", "direction": "down" },
  "tags": ["memory", "audio", "transcription", "recaps", "rewind"],
  "keywords": ["life recorder", "conversations", "shadow", "rewind", "recaps"],
  "engines": {
    "ryu": ">=0.3.1"
  },
  "surfaces": {
    "gateway": {
      "support": "none"
    },
    "core": {
      "support": "none"
    },
    "desktop": {
      "support": "full"
    },
    "island": {
      "support": "limited"
    },
    "mobile": {
      "support": "limited"
    },
    "extension": {
      "support": "none"
    },
    "web": {
      "support": "limited"
    },
    "cli": {
      "support": "none"
    }
  },
  "runnables": [
    {
      "id": "life-recorder-companion",
      "name": "Life Recorder",
      "kind": "companion",
      "config": {
        "label": "Life Recorder",
        "ui_entry": "./ui/dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": [
    "storage:kv",
    "crypto:seal",
    "media:transcribe",
    "hook:side-model",
    "timeline:speech",
    "media:record"
  ],
  "permission_levels": [
    {
      "id": "life-recorder.manage",
      "label": "Can record and recall",
      "description": "Read Shadow speech history, transcribe audio, create model-generated recaps, and save or delete encrypted moments in this app's private library."
    }
  ],
  "companion": {
    "label": "Life Recorder",
    "icon": "mic-01"
  }
}

{
  "tags": ["voice", "tts", "stt", "speech", "transcription"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-voice",
  "homepage": "https://github.com/amajorai/ryu-voice",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/voice",
  "name": "Voice Studio",
  "version": "0.2.0",
  "stability": "experimental",
  "category": "Media & Voice",
  "description": "A private voice library and speech studio. Record or upload consented voice samples, write scripts and multi-voice stories, shape takes with speed, seed, effects, and loudness, and generate speech with the TTS models available on your Ryu node.",
  "tagline": "Build voices and bring scripts to life",
  "keywords": [
    "voice",
    "tts",
    "speech",
    "voice cloning",
    "studio",
    "stories",
    "audio effects"
  ],
  "icon": "audio-wave-01",
  "iconDither": { "from": 221, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "full" },
    "mobile": { "support": "full" },
    "extension": { "support": "full" },
    "web": { "support": "full" },
    "cli": { "support": "full" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "voice-companion",
      "name": "Voice Studio",
      "kind": "companion",
      "config": {
        "label": "Voice Studio",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": [
    "files:download",
    "media:generate",
    "media:record",
    "media:transcribe",
    "storage:kv",
    "voice:models:manage"
  ],
  "permission_levels": [
    {
      "id": "voice.models.manage",
      "label": "Can manage voices",
      "description": "Install optional speech engines and models on this node. Engine setup downloads runtime dependencies and model weights use local disk."
    },
    {
      "id": "voice.studio.generate",
      "label": "Can generate speech",
      "description": "Use an available speech model to generate audio from the script and optional voice sample you provide."
    }
  ],
  "companion": {
    "label": "Voice Studio",
    "icon": "audio-wave-01"
  },
  "contributes": {
    "sidebar_buttons": [
      {
        "id": "voice-studio",
        "title": "Studio",
        "icon": "mic-01",
        "target": "/plugin/app__voice-companion",
        "context": { "view": "studio" },
        "order": 10
      },
      {
        "id": "voice-library",
        "title": "Voice Library",
        "icon": "user-voice-01",
        "target": "/plugin/app__voice-companion",
        "context": { "view": "voices" },
        "order": 11
      },
      {
        "id": "voice-history",
        "title": "History",
        "icon": "clock-01",
        "target": "/plugin/app__voice-companion",
        "context": { "view": "history" },
        "order": 12
      },
      {
        "id": "voice-stories",
        "title": "Stories",
        "icon": "book-open-01",
        "target": "/plugin/app__voice-companion",
        "context": { "view": "stories" },
        "order": 13
      }
    ]
  }
}

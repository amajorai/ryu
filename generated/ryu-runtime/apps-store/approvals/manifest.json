{
  "tags": ["approvals", "human-in-the-loop", "security", "review"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-approvals",
  "homepage": "https://github.com/amajorai/ryu-approvals",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/approvals",
  "name": "Approvals",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Security",
  "description": "Approval inbox: a human-in-the-loop queue where agent-proposed actions, edits, and fixes wait for your accept or reject before they take effect.",
  "tagline": "Nothing happens until you say yes",
  "keywords": ["approvals", "human-in-the-loop", "security", "review"],
  "icon": "shield-01",
  "iconDither": { "from": 312, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "approvals-companion",
      "name": "Inbox",
      "kind": "companion",
      "config": {
        "label": "Inbox",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": [
    "approvals:crud",
    "notifications:send-to-user",
    "quests:crud",
    "ui:toast",
    "shell:integrate"
  ],
  "permission_levels": [
    {
      "id": "approvals.view",
      "label": "Can view",
      "description": "Read the approval inbox and see what an agent is waiting to do, without accepting or rejecting anything."
    },
    {
      "id": "approvals.decide",
      "label": "Can decide",
      "description": "Accept or reject queued items, which is what lets an agent's proposed action, edit, or fix actually take effect.",
      "implies": ["approvals.view"]
    }
  ],
  "companion": {
    "label": "Inbox",
    "icon": "shield-01"
  },
  "contributes": {
    "chat_widget_templates": [
      {
        "id": "approvals.chat",
        "title": "Approvals widget",
        "description": "Approvals chat widget metadata is coming soon; no render tool is available yet.",
        "triggers": ["approvals widget"],
        "examples": ["Show me a approvals widget"],
        "backing": {},
        "display_mode": "inline",
        "safe_action_ids": [],
        "availability": "coming-soon"
      }
    ]
  }
}

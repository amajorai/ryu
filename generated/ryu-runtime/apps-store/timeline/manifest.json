{
  "tags": ["timeline", "replay", "screen", "journal"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-timeline",
  "homepage": "https://github.com/amajorai/ryu-timeline",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/timeline",
  "name": "Timeline",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Productivity",
  "description": "The activity timeline with Replay lanes and a chronological History view over Shadow's captured screen/input/window/audio lanes, plus a keyframe preview, Dayflow work journal, and jump-to-moment focus.",
  "tagline": "Scrub back through everything your screen did",
  "keywords": ["timeline", "replay", "screen", "journal"],
  "icon": "timeline",
  "iconDither": { "from": 347, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "timeline-companion",
      "name": "Timeline",
      "kind": "companion",
      "config": {
        "label": "Timeline",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": ["timeline:read", "shell:integrate"],
  "permission_levels": [
    {
      "id": "timeline.view",
      "label": "Can view",
      "description": "Replay Shadow's captured screen, window, and audio lanes and the work journal built from them, which exposes everything recorded on this machine."
    }
  ],
  "companion": {
    "label": "Timeline",
    "icon": "timeline"
  },
  "contributes": {
    "chat_widget_templates": [
      {
        "id": "timeline.chat",
        "title": "Timeline widget",
        "description": "Timeline chat widget metadata is coming soon; no render tool is available yet.",
        "triggers": ["timeline widget"],
        "examples": ["Show me a timeline widget"],
        "backing": {},
        "display_mode": "inline",
        "safe_action_ids": [],
        "availability": "coming-soon"
      }
    ]
  }
}

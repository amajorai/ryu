{
  "tags": ["browser", "automation", "cloudflare", "remote", "web"],
  "id": "@ryu/cloudflare-browser-run",
  "name": "Cloudflare Browser Run",
  "version": "0.1.0",
  "external": true,
  "description": "Hosted Browser Run quick actions over Cloudflare's remote OAuth MCP server. Adds URL-scoped navigate, snapshot, and screenshot verbs to Ryu's swappable browser.control layer; the full Browser Run MCP tool set remains available under cloudflare.*.",
  "tagline": "Hosted browser automation on Cloudflare's edge",
  "icon": "ai-browser",
  "iconDither": { "from": 25, "to": "transparent", "direction": "down" },
  "banner": {
    "style": "gradient",
    "colors": ["#f38020", "#111827"],
    "seed": 42
  },
  "author": { "name": "Cloudflare", "url": "https://www.cloudflare.com" },
  "homepage": "https://developers.cloudflare.com/browser-run/",
  "repository": "https://github.com/cloudflare/mcp-server-cloudflare",
  "privacyPolicyUrl": "https://www.cloudflare.com/privacypolicy/",
  "termsOfServiceUrl": "https://www.cloudflare.com/terms/",
  "license": "Apache-2.0",
  "keywords": ["browser", "automation", "cloudflare", "remote", "web"],
  "category": "Browsers",
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "full" },
    "mobile": { "support": "full" },
    "extension": { "support": "full" },
    "web": { "support": "full" },
    "cli": { "support": "full" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [],
  "provides": [
    {
      "capability": "browser.control",
      "version": "1.0.0",
      "title": "Browser",
      "grant": "browser:control",
      "selectable": true,
      "target": "remote-desktop",
      "tools": {
        "browser.navigate": {
          "tool": "cloudflare.get_url_snapshot",
          "adapter": { "code_file": "adapters/browser.navigate.js" }
        },
        "browser.snapshot": {
          "tool": "cloudflare.get_url_snapshot",
          "adapter": { "code_file": "adapters/browser.snapshot.js" }
        },
        "browser.screenshot": {
          "tool": "cloudflare.get_url_screenshot",
          "adapter": { "code_file": "adapters/browser.screenshot.js" }
        }
      }
    }
  ],
  "permission_grants": ["mcp:server", "identity.read", "tool:execute"],
  "mcp_servers": {
    "cloudflare": {
      "type": "streamable-http",
      "url": "https://browser.mcp.cloudflare.com/mcp",
      "auth": { "type": "oauth" },
      "description": "Cloudflare Browser Run remote OAuth MCP server. Native tools include HTML, Markdown, PDF, snapshot, screenshot, JSON, links, crawl, and browser-session operations."
    }
  }
}

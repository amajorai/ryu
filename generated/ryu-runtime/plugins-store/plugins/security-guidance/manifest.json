{
  "tags": ["security", "review", "code", "vulnerabilities"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/plugins/security-guidance",
  "homepage": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/plugins/security-guidance",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/security-guidance",
  "name": "Security Guidance",
  "version": "0.1.14",
  "stability": "experimental",
  "description": "Scans each answer for security vulnerabilities and has a second model review the code before you ship it. Off until you flip the Security review toggle in the composer, or run `/security` for a one-off review of the last answer; the reviewer model is configurable.",
  "tagline": "Catch vulnerabilities before you ship them",
  "keywords": ["security", "review", "code", "vulnerabilities"],
  "category": "Security",
  "icon": "shield-key",
  "iconDither": { "from": 320, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "limited" },
    "web": { "support": "full" },
    "cli": { "support": "full" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [],
  "permission_grants": ["hook:side-model"],
  "activation_events": ["*"],
  "contributes": {
    "composer_controls": [
      {
        "id": "security-guidance.toggle",
        "type": "toggle",
        "flag": "io.ryu.security-guidance",
        "label": "Security review",
        "description": "Scan each answer for security vulnerabilities and review the code with a second model."
      }
    ],
    "settings_tabs": [
      {
        "id": "security-guidance.settings",
        "title": "Security review",
        "fields": [
          {
            "type": "model_picker",
            "pref_key": "security-review-model",
            "label": "Reviewer model",
            "description": "Optional model used for security reviews. Leave empty to use the node's default."
          }
        ]
      }
    ],
    "slash_commands": [
      {
        "id": "security-guidance.run",
        "command": "/security",
        "description": "Run a one-off security review of the last answer."
      }
    ],
    "turn_hooks": [
      {
        "id": "security-guidance.review",
        "on": "post_assistant_turn",
        "match": {
          "flag": "io.ryu.security-guidance",
          "commands": ["/security"]
        },
        "code_file": "hooks/review.js"
      }
    ]
  }
}

{
  "tags": ["chat", "prompts", "composer", "suggestions", "productivity"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/plugins/prompt-suggestions",
  "homepage": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/plugins/prompt-suggestions",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/prompt-suggestions",
  "name": "Prompt Suggestions",
  "version": "0.1.0",
  "stability": "experimental",
  "description": "Fast next-prompt suggestions in the chat composer, generated by a lightweight side agent from recent chat context.",
  "tagline": "A faster way to decide what to ask next",
  "keywords": ["chat", "prompts", "composer", "suggestions", "productivity"],
  "category": "Productivity",
  "icon": "sparkles-02",
  "iconDither": { "from": 324, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "limited" },
    "web": { "support": "full" },
    "cli": { "support": "limited" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [],
  "permission_grants": [],
  "activation_events": ["*"],
  "contributes": {
    "settings_tabs": [
      {
        "id": "prompt-suggestions.settings",
        "title": "Prompt Suggestions",
        "scope": "node",
        "fields": [
          {
            "type": "toggle",
            "pref_key": "chat-suggestions-enabled",
            "label": "Suggest next prompts",
            "description": "Show fast, context-aware prompts in the chat composer.",
            "default": true
          },
          {
            "type": "model_picker",
            "pref_key": "chat-suggestions-model",
            "label": "Suggestion model",
            "description": "Optional lightweight model for suggestions. Empty uses the local engine fallback."
          }
        ]
      }
    ]
  }
}

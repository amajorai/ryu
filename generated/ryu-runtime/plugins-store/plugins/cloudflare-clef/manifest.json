{
  "id": "@ryu/cloudflare-clef",
  "name": "Cloudflare Clef Decisions",
  "version": "0.1.0",
  "stability": "experimental",
  "description": "Use Cloudflare Workers AI Clef and Clef Flash as a swappable typed-decision provider. State, questions, and optional embedded images are sent to Cloudflare Workers AI from the selected Ryu node.",
  "tagline": "Hosted multimodal typed decisions",
  "homepage": "https://developers.cloudflare.com/workers-ai/models/clef/",
  "license": "Apache-2.0",
  "category": "Models",
  "keywords": [
    "decision models",
    "classification",
    "cloudflare",
    "workers ai",
    "clef"
  ],
  "tags": [
    "models",
    "decision",
    "classification",
    "cloudflare",
    "workers-ai",
    "vision"
  ],
  "icon": "ai-brain-01",
  "iconDither": { "from": 240, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": {
      "support": "none"
    },
    "core": {
      "support": "full"
    },
    "desktop": {
      "support": "full"
    },
    "island": {
      "support": "limited"
    },
    "mobile": {
      "support": "limited"
    },
    "extension": {
      "support": "limited"
    },
    "web": {
      "support": "full"
    },
    "cli": {
      "support": "full"
    }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "tool-cloudflare-clef-predict",
      "name": "Cloudflare Clef Predict",
      "kind": "tool",
      "config": {
        "slug": "cloudflare-clef.predict",
        "backend": "http",
        "method": "POST",
        "url": "core:/api/ext/@ryu/cloudflare-clef/predict",
        "secret_headers": {
          "Authorization": "Bearer env:RYU_TOKEN"
        },
        "fail_open": false,
        "unwrap_body": true,
        "body_defaults": {
          "model": "clef"
        },
        "description": "Ask Cloudflare Workers AI Clef or Clef Flash typed questions about text, JSON, or up to four embedded images. Returns structured answers and probabilities, not generated prose.",
        "input_schema": {
          "type": "object",
          "properties": {
            "state": {
              "description": "The text, JSON object, or list to evaluate.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object"
                },
                {
                  "type": "array"
                }
              ]
            },
            "questions": {
              "type": "object",
              "description": "Question ids mapped to typed `noul`, `choice`, or `score` definitions.",
              "minProperties": 1,
              "maxProperties": 64,
              "additionalProperties": {
                "type": "object"
              }
            },
            "images": {
              "type": "array",
              "description": "Optional embedded PNG, JPEG, or WebP images. Remote URLs are not accepted.",
              "maxItems": 4,
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[Dd][Aa][Tt][Aa]:image/(png|jpeg|webp);base64,"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "content_type": {
                        "type": "string",
                        "enum": ["image/png", "image/jpeg", "image/webp"]
                      },
                      "base64": {
                        "type": "string"
                      }
                    },
                    "required": ["content_type", "base64"]
                  }
                ]
              }
            },
            "model": {
              "type": "string",
              "enum": ["clef", "clef-flash"],
              "default": "clef",
              "description": "Cloudflare model id. Clef is the 27B model; Clef Flash is the 9B model."
            }
          },
          "required": ["state", "questions"]
        }
      }
    }
  ],
  "provides": [
    {
      "capability": "decision.typed",
      "version": "1.0.0",
      "title": "Typed Decisions",
      "selectable": true,
      "layerKind": "decision-model",
      "tools": {
        "decision.predict": {
          "tool": "cloudflare-clef.predict"
        },
        "decision.predict_multimodal": {
          "tool": "cloudflare-clef.predict"
        }
      }
    }
  ],
  "permission_grants": [
    "sidecar:process",
    "runtime:external",
    "tool:http-egress:127.0.0.1",
    "tool:http-egress:api.cloudflare.com"
  ],
  "permission_levels": [
    {
      "id": "cloudflare-clef.predict",
      "label": "Send decisions to Cloudflare Workers AI",
      "description": "Send the supplied state, typed questions, and optional embedded images to the selected Cloudflare Workers AI Clef model.",
      "implies": []
    }
  ],
  "sidecars": [
    {
      "name": "cloudflare-clef",
      "port": 18154,
      "health_path": "/health",
      "lazy": true,
      "idle_stop_secs": 1800,
      "process": {
        "kind": "python",
        "entry": "ryu_cloudflare_clef",
        "port_env": "RYU_CLOUDFLARE_CLEF_PORT",
        "python_version": "3.11",
        "pyproject_extra": "server",
        "source": {
          "url": "",
          "format": "directory",
          "path": "sidecar"
        },
        "env": {
          "RYU_CLOUDFLARE_CLEF_HOST": "127.0.0.1",
          "RYU_CLOUDFLARE_ACCOUNT_ID": "env:RYU_CLOUDFLARE_ACCOUNT_ID",
          "RYU_CLOUDFLARE_API_TOKEN": "env:RYU_CLOUDFLARE_API_TOKEN"
        }
      },
      "http": {
        "max_body_bytes": 13631488,
        "routes": [
          {
            "path": "/health"
          },
          {
            "path": "/predict",
            "method": "POST",
            "permission": "cloudflare-clef.predict"
          }
        ]
      }
    }
  ],
  "contributes": {
    "settings_tabs": [
      {
        "id": "cloudflare-clef.settings",
        "title": "Cloudflare Clef",
        "scope": "node",
        "fields": [
          {
            "type": "secret",
            "pref_key": "RYU_CLOUDFLARE_ACCOUNT_ID",
            "label": "Cloudflare account ID",
            "description": "The account that has Workers AI enabled. Stored encrypted on this node."
          },
          {
            "type": "secret",
            "pref_key": "RYU_CLOUDFLARE_API_TOKEN",
            "label": "Cloudflare API token",
            "description": "A token with access to run Workers AI models in this account. Stored encrypted on this node and never shown again."
          }
        ]
      }
    ]
  }
}

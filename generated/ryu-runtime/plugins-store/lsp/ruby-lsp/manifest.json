{
  "tags": ["ruby", "rails", "ruby-lsp", "language-server", "developer"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/lsp/ruby-lsp",
  "homepage": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/lsp/ruby-lsp",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/ruby-lsp",
  "name": "Ruby LSP",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Developer Tools",
  "description": "Ruby language server (ruby-lsp) for the ryu agent: definitions, references, hover, symbols, implementations, call hierarchies and diagnostics after every edit. You install ruby-lsp; the plugin ships config.",
  "tagline": "Ruby code intelligence via ruby-lsp",
  "keywords": ["ruby", "rails", "ruby-lsp", "language-server", "developer"],
  "icon": "braces",
  "iconDither": {
    "from": 288,
    "to": "transparent",
    "direction": "down"
  },
  "surfaces": {
    "gateway": {
      "support": "none"
    },
    "core": {
      "support": "full"
    },
    "desktop": {
      "support": "full"
    },
    "island": {
      "support": "limited"
    },
    "mobile": {
      "support": "limited"
    },
    "extension": {
      "support": "limited"
    },
    "web": {
      "support": "limited"
    },
    "cli": {
      "support": "full"
    }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [],
  "permission_grants": ["pi:extension"],
  "activation_events": ["*"],
  "contributes": {
    "lsp_servers": {
      "ruby-lsp": {
        "command": "ruby-lsp",
        "extensionToLanguage": {
          ".rb": "ruby",
          ".rake": "ruby",
          ".gemspec": "ruby",
          ".ru": "ruby",
          ".erb": "erb"
        }
      }
    }
  }
}

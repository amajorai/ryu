{
  "tags": [
    "python",
    "pyright",
    "type-checking",
    "language-server",
    "developer"
  ],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/lsp/pyright-lsp",
  "homepage": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/lsp/pyright-lsp",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/pyright-lsp",
  "name": "Python LSP",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Developer Tools",
  "description": "Python language server (Pyright) for the ryu agent: type checking plus definitions, references, hover, symbols, implementations, call hierarchies and diagnostics after every edit. You install pyright-langserver; the plugin ships config.",
  "tagline": "Python code intelligence via Pyright",
  "keywords": [
    "python",
    "pyright",
    "type-checking",
    "language-server",
    "developer"
  ],
  "icon": "binary-code",
  "iconDither": {
    "from": 256,
    "to": "transparent",
    "direction": "down"
  },
  "surfaces": {
    "gateway": {
      "support": "none"
    },
    "core": {
      "support": "full"
    },
    "desktop": {
      "support": "full"
    },
    "island": {
      "support": "limited"
    },
    "mobile": {
      "support": "limited"
    },
    "extension": {
      "support": "limited"
    },
    "web": {
      "support": "limited"
    },
    "cli": {
      "support": "full"
    }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [],
  "permission_grants": ["pi:extension"],
  "activation_events": ["*"],
  "contributes": {
    "lsp_servers": {
      "pyright": {
        "command": "pyright-langserver",
        "args": ["--stdio"],
        "extensionToLanguage": {
          ".py": "python",
          ".pyi": "python"
        }
      }
    }
  }
}

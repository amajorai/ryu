{
  "tags": ["java", "jdtls", "eclipse", "language-server", "developer"],
  "author": { "name": "Ryu", "url": "https://ryuhq.com" },
  "repository": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/lsp/jdtls-lsp",
  "homepage": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/lsp/jdtls-lsp",
  "privacyPolicyUrl": "https://ryuhq.com/privacy",
  "termsOfServiceUrl": "https://ryuhq.com/terms",
  "id": "@ryu/jdtls-lsp",
  "name": "Java LSP",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Developer Tools",
  "description": "Java language server (Eclipse JDT.LS) for the ryu agent: definitions, references, hover, symbols, implementations, call hierarchies and diagnostics after every edit. You install jdtls; the plugin ships config.",
  "tagline": "Java code intelligence via Eclipse JDT.LS",
  "keywords": ["java", "jdtls", "eclipse", "language-server", "developer"],
  "icon": "code-01",
  "iconDither": {
    "from": 128,
    "to": "transparent",
    "direction": "down"
  },
  "surfaces": {
    "gateway": {
      "support": "none"
    },
    "core": {
      "support": "full"
    },
    "desktop": {
      "support": "full"
    },
    "island": {
      "support": "limited"
    },
    "mobile": {
      "support": "limited"
    },
    "extension": {
      "support": "limited"
    },
    "web": {
      "support": "limited"
    },
    "cli": {
      "support": "full"
    }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [],
  "permission_grants": ["pi:extension"],
  "activation_events": ["*"],
  "contributes": {
    "lsp_servers": {
      "jdtls": {
        "command": "jdtls",
        "extensionToLanguage": {
          ".java": "java"
        },
        "startupTimeout": 120000
      }
    }
  }
}

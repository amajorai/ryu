+  @Nullable
+  private Bitmap decodeSenderAvatar(@NonNull Context context) {
+    if (mBody == null) {
+      return null;
+    }
+    String path = mBody.optString("ryuLargeIconPath", "");
+    if (path.startsWith("file://")) {
+      path = Uri.parse(path).getPath();
+    }
+    if (path == null || path.isEmpty()) {
+      return null;
+    }
+    try {
+      java.io.File file = new java.io.File(path).getCanonicalFile();
+      String cacheDir = context.getCacheDir().getCanonicalPath() + java.io.File.separator;
+      if (!file.getPath().startsWith(cacheDir) || !file.isFile()) {
+        return null;
+      }
+      return BitmapFactory.decodeFile(file.getPath());
+    } catch (IOException | SecurityException e) {
+      Log.w("expo-notifications", "Could not read the sender avatar.", e);
+      return null;
+    }
+  }

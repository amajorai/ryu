+/**
+* Ryu patch: keep each DPoP proof reservation 60 s past the proof's acceptance
+* window. `verifyDpopProof` accepts a proof while floor(now) - iat <= maxAge,
+* that is through iat + maxAge + 1 s, but reserves it only until iat + maxAge,
+* and every verification lookup deletes expired rows, so a proof accepted in
+* the last second of its window could be accepted again. The margin matches
+* `DPOP_RESERVATION_MARGIN_MS` in @ryu/auth `lib/oauth-dpop` and also covers
+* clock skew between instances.
+*/
+function createDpopReplayStoreOutlivingWindow(reservations) {
+	const store = createDpopReplayStore(reservations);
+	return { reserve: (reservation) => store.reserve({
+		...reservation,
+		expiresAt: new Date(reservation.expiresAt.getTime() + 6e4)
+	}) };
+}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Every other tsconfig in the repo sets this; without it, two transitively
    // installed @types/node copies (22.20.1 and 25.5.0) are both loaded and
    // collide, producing 177 duplicate-identifier errors inside node_modules
    // that say nothing about this package's own code.
    "skipLibCheck": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}

{
  "name": "@ryuhq/services",
  "version": "0.1.0",
  "type": "module",
  "description": "One TypeScript entry point for Ryu's standalone services: Managed Agents, Messaging, Mail, Notify, Box, Gateway, Connect, Passport and Sites",
  "repository": {
    "type": "git",
    "url": "https://github.com/amajorai/ryu-sdk",
    "directory": "packages/services"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks/index.d.ts",
        "default": "./dist/webhooks/index.js"
      },
      "require": {
        "types": "./dist/webhooks/index.d.cts",
        "default": "./dist/webhooks/index.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      },
      "require": {
        "types": "./dist/errors.d.cts",
        "default": "./dist/errors.cjs"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/tools/index.d.ts",
        "default": "./dist/tools/index.js"
      },
      "require": {
        "types": "./dist/tools/index.d.cts",
        "default": "./dist/tools/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "bun test"
  },
  "dependencies": {
    "@ryuhq/client": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@react-email/render": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "hono": "^4.8.2",
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}

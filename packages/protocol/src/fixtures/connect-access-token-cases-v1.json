{
  "version": 1,
  "note": "Tokens are built at test time with a key generated by the test: no key or token is stored here. `signer: other` signs with a second generated key; `kid: known` keeps the known key's thumbprint.",
  "issuer": "https://api.ryu.example",
  "audience": "https://connect.ryu.example",
  "signerInput": {
    "audience": "https://connect.ryu.example",
    "clientId": "ryu-cli",
    "issuer": "https://api.ryu.example",
    "jti": "8d8a5f0e-2f43-4c43-9a83-6c1d4f1b2a10",
    "now": "2026-10-21T12:00:00.000Z",
    "organizationId": "6650f0c1a2b3c4d5e6f70812",
    "organizationRole": "member",
    "scopes": ["tools:read", "tools:exec"],
    "subject": "6650f0c1a2b3c4d5e6f70999",
    "teamId": "6650f0c1a2b3c4d5e6f70aaa",
    "ttlSeconds": 600
  },
  "expectedHeader": {
    "alg": "EdDSA",
    "typ": "at+jwt"
  },
  "expectedClaims": {
    "aud": "https://connect.ryu.example",
    "client_id": "ryu-cli",
    "exp": 1792584600,
    "iat": 1792584000,
    "iss": "https://api.ryu.example",
    "jti": "8d8a5f0e-2f43-4c43-9a83-6c1d4f1b2a10",
    "nbf": 1792584000,
    "org_id": "6650f0c1a2b3c4d5e6f70812",
    "org_role": "member",
    "scope": "tools:read tools:exec",
    "sub": "6650f0c1a2b3c4d5e6f70999",
    "team_id": "6650f0c1a2b3c4d5e6f70aaa",
    "tenant": "org_6650f0c1a2b3c4d5e6f70812"
  },
  "cases": [
    {
      "name": "the golden claims are accepted",
      "now": 1792584030,
      "expected": {
        "ok": true,
        "tenantId": "org_6650f0c1a2b3c4d5e6f70812",
        "teamId": "6650f0c1a2b3c4d5e6f70aaa",
        "scopes": ["tools:read", "tools:exec"],
        "subject": "6650f0c1a2b3c4d5e6f70999"
      }
    },
    {
      "name": "a token without a team is accepted without one",
      "claims": {
        "team_id": null,
        "scope": "tools:read"
      },
      "now": 1792584000,
      "expected": {
        "ok": true,
        "tenantId": "org_6650f0c1a2b3c4d5e6f70812",
        "teamId": null,
        "scopes": ["tools:read"],
        "subject": "6650f0c1a2b3c4d5e6f70999"
      }
    },
    {
      "name": "an expired token is refused",
      "now": 1792584661,
      "expected": {
        "ok": false,
        "reason": "expired"
      }
    },
    {
      "name": "a token inside the skew after expiry is accepted",
      "now": 1792584659,
      "expected": {
        "ok": true,
        "tenantId": "org_6650f0c1a2b3c4d5e6f70812",
        "teamId": "6650f0c1a2b3c4d5e6f70aaa",
        "scopes": ["tools:read", "tools:exec"],
        "subject": "6650f0c1a2b3c4d5e6f70999"
      }
    },
    {
      "name": "a token used before it is valid is refused",
      "now": 1792583939,
      "expected": {
        "ok": false,
        "reason": "not_yet_valid"
      }
    },
    {
      "name": "a token issued in the future is refused",
      "claims": {
        "iat": 1792584120,
        "nbf": 1792584000,
        "exp": 1792584600
      },
      "now": 1792584000,
      "expected": {
        "ok": false,
        "reason": "not_yet_valid"
      }
    },
    {
      "name": "a token for another audience is refused",
      "claims": {
        "aud": "urn:ryu:node:abc"
      },
      "now": 1792584000,
      "expected": {
        "ok": false,
        "reason": "wrong_audience"
      }
    },
    {
      "name": "a token from another issuer is refused",
      "claims": {
        "iss": "https://evil.example"
      },
      "now": 1792584000,
      "expected": {
        "ok": false,
        "reason": "wrong_issuer"
      }
    },
    {
      "name": "a token signed by an unknown key is refused",
      "signer": "other",
      "kid": "signer",
      "now": 1792584000,
      "expected": {
        "ok": false,
        "reason": "unknown_key"
      }
    },
    {
      "name": "a token whose kid names the known key but another key signed it is refused",
      "signer": "other",
      "kid": "known",
      "now": 1792584000,
      "expected": {
        "ok": false,
        "reason": "bad_signature"
      }
    },
    {
      "name": "a tampered signature is refused",
      "tamper": "signature",
      "now": 1792584000,
      "expected": {
        "ok": false,
        "reason": "bad_signature"
      }
    },
    {
      "name": "a node delegation header type is refused",
      "header": {
        "typ": "JWT"
      },
      "now": 1792584000,
      "expected": {
        "ok": false,
        "reason": "malformed"
      }
    },
    {
      "name": "the none algorithm is refused",
      "header": {
        "alg": "none"
      },
      "tamper": "unsigned",
      "now": 1792584000,
      "expected": {
        "ok": false,
        "reason": "unsupported_algorithm"
      }
    },
    {
      "name": "a lifetime over fifteen minutes is refused",
      "claims": {
        "exp": 1792587600
      },
      "now": 1792584000,
      "expected": {
        "ok": false,
        "reason": "lifetime_too_long"
      }
    },
    {
      "name": "a tenant that is not the organization's is refused",
      "claims": {
        "tenant": "org_someoneelse"
      },
      "now": 1792584000,
      "expected": {
        "ok": false,
        "reason": "tenant_mismatch"
      }
    },
    {
      "name": "a token without tools:read is refused",
      "claims": {
        "scope": "tools:exec"
      },
      "now": 1792584000,
      "expected": {
        "ok": false,
        "reason": "no_read_scope"
      }
    },
    {
      "name": "unknown claims are refused",
      "claims": {
        "admin": true
      },
      "now": 1792584000,
      "expected": {
        "ok": false,
        "reason": "bad_claims"
      }
    },
    {
      "name": "a missing expiry is refused",
      "claims": {
        "exp": null
      },
      "now": 1792584000,
      "expected": {
        "ok": false,
        "reason": "bad_claims"
      }
    },
    {
      "name": "two segments are refused",
      "tamper": "two_segments",
      "now": 1792584000,
      "expected": {
        "ok": false,
        "reason": "malformed"
      }
    }
  ]
}

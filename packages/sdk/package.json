{
  "name": "@ryuhq/sdk",
  "version": "0.2.3",
  "type": "module",
  "description": "Ryu developer SDK: typed builders and CLI for authoring manifest.json Plugin bundles",
  "repository": {
    "type": "git",
    "url": "https://github.com/amajorai/ryu"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "require": "./dist/manifest.cjs"
    },
    "./agent-plugin": {
      "types": "./dist/agent-plugin.d.ts",
      "import": "./dist/agent-plugin.js",
      "require": "./dist/agent-plugin.cjs"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "require": "./dist/agent.cjs"
    },
    "./action": {
      "types": "./dist/action.d.ts",
      "import": "./dist/action.js",
      "require": "./dist/action.cjs"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js",
      "require": "./dist/model.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "require": "./dist/mcp.cjs"
    },
    "./mcp/server": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js",
      "require": "./dist/mcp/server.cjs"
    },
    "./mcp/client": {
      "types": "./dist/mcp/client.d.ts",
      "import": "./dist/mcp/client.js",
      "require": "./dist/mcp/client.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./runnable": {
      "types": "./dist/runnable.d.ts",
      "import": "./dist/runnable.js",
      "require": "./dist/runnable.cjs"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js",
      "require": "./dist/builder.cjs"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "ryu": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "generate:contracts": "bun run scripts/generate-contracts.ts",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ryuhq/sdk-native": "workspace:*",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "^22.20.1",
    "json-schema-to-typescript": "^15.0.4",
    "tsup": "^8.5.1",
    "typescript": "^5"
  }
}
